namespace System;

public struct TimeSpan {
    private long _milliseconds;

    public long Hours {
        const get {
            return TotalHours % 24l;
        }
    }

    public long Minutes {
        const get {
            return TotalMinutes % 60l;
        }
    }

    public long Seconds {
        const get {
            return TotalSeconds % 60l;
        }
    }

    public long Milliseconds {
        const get { 
            return _milliseconds; 
        }  
    }

    public long TotalDays { 
        const get {
            return _milliseconds / (24l * 60l * 60l * 1000l);
        } 
    }

    public long TotalHours { 
        const get {
            return _milliseconds / (60l * 60l * 1000l);
        } 
    }

    public long TotalMinutes { 
        const get {
            return _milliseconds / (60l * 1000l);
        } 
    }

    public long TotalSeconds { 
        const get {
            return _milliseconds / 1000l;
        } 
    }

    public constructor(long milliseconds) {
        _milliseconds = milliseconds;
    }

    public constructor(
        long days, 
        long hours, 
        long minutes, 
        long seconds, 
        long milliseconds
    ) {
        _milliseconds =
            days * 24l * 60l * 60l * 1000l +
            hours * 60l * 60l * 1000l +
            minutes * 60l * 1000l +
            seconds * 1000l +
            milliseconds;
    }

    public constructor(const DateTime from, const DateTime to) {
        _milliseconds = to.Milliseconds - from.Milliseconds;
    }

    public TimeSpan AddDays(long days) const {
        return new TimeSpan(_milliseconds + days * (24l * 60l * 60l * 1000l));
    }

    public TimeSpan AddHours(long hours) const {
        return new TimeSpan(_milliseconds + hours * (60l * 60l * 1000l));
    }

    public TimeSpan AddMinutes(long minutes) const {
        return new TimeSpan(_milliseconds + minutes * (60l * 1000l));
    }

    public TimeSpan AddSeconds(long seconds) const {
        return new TimeSpan(_milliseconds + seconds * 1000l);
    }

    public TimeSpan AddMilliseconds(long milliseconds) const {
        return new TimeSpan(_milliseconds + milliseconds);
    }
}
