namespace System;

public struct TimeSpan {
    private long _milliseconds;

    public long Hours {
        const get {
            return TotalHours % 24;
        }
    }

    public long Minutes {
        const get {
            return TotalMinutes % 60;
        }
    }

    public long Seconds {
        const get {
            return TotalSeconds % 60;
        }
    }

    public long Milliseconds {
        const get {
            return _milliseconds;
        }
    }

    public long TotalDays {
        const get {
            return _milliseconds / (24 * 60 * 60 * 1000);
        }
    }

    public long TotalHours {
        const get {
            return _milliseconds / (60 * 60 * 1000);
        }
    }

    public long TotalMinutes {
        const get {
            return _milliseconds / (60 * 1000);
        }
    }

    public long TotalSeconds {
        const get {
            return _milliseconds / 1000;
        }
    }

    public constructor(long milliseconds) {
        _milliseconds = milliseconds;
    }

    public constructor(
        long days,
        long hours,
        long minutes,
        long seconds,
        long milliseconds
    ) {
        _milliseconds =
            days * (24 * 60 * 60 * 1000) +
            hours * (60 * 60 * 1000) +
            minutes * (60 * 1000) +
            seconds * 1000 +
            milliseconds;
    }

    public constructor(const DateTime from, const DateTime to) {
        _milliseconds = to.Milliseconds - from.Milliseconds;
    }

    public TimeSpan AddDays(long days) const {
        return new TimeSpan(_milliseconds + days * (24 * 60 * 60 * 1000));
    }

    public TimeSpan AddHours(long hours) const {
        return new TimeSpan(_milliseconds + hours * (60 * 60 * 1000));
    }

    public TimeSpan AddMinutes(long minutes) const {
        return new TimeSpan(_milliseconds + minutes * (60 * 1000));
    }

    public TimeSpan AddSeconds(long seconds) const {
        return new TimeSpan(_milliseconds + seconds * 1000);
    }

    public TimeSpan AddMilliseconds(long milliseconds) const {
        return new TimeSpan(_milliseconds + milliseconds);
    }
}
