namespace System;
public class ArgumentException : Exception {
    private string _paramName;

    public string ParamName { const get { return _paramName; } }

    public constructor() : this(null, null) { }

    public constructor(const string message) : this(message, null) { }

    public constructor(const string message, const string paramName) : base(message) {
        _paramName = paramName;
    }

    public constructor(const string message, const string paramName,
        const Exception innerException) : base(message, innerException) {
        _paramName = paramName;
    }
}
