import System.Reflection;

namespace System;

public class Exception {
    private string _message;
    private Exception? _innerException;
    private string _stackTrace;

    public string Message {
        const get {
            return _message;
        }
    }

    public Exception? InnerException {
        const get {
            return _innerException;
        }
    }

    public TypeInfo RuntimeType { extern const get; }
    public string StackTrace { extern const get; }

    public constructor(const string message) {
        _message = message ?? "An exception occurred.";
        _stackTrace = null;
    }

    public constructor(const string message, const Exception innerException) {
        _message = message ?? "An exception occurred.";
        _innerException = innerException;
        _stackTrace = null;
    }

    public constructor() : this(null) { }

    public static extern void Throw(const Exception exception);

    public static extern bool Matches(const Exception exception, const TypeInfo typeInfo);
}
