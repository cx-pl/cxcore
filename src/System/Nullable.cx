namespace System;

public struct Nullable<T> {
    private ptr<T> _obj;

    public static const Nullable<T> Null { extern const get; }
    public bool HasValue { extern const get; }
    public T Value { extern const get; extern set; }
    public extern constructor(T obj);

    // Used by the compiler when lifting a value into its nullable representation.
    // Keep allocation behind Memory so a future collector can own this storage.
    public static extern ptr CreateValueStorage(ptr value, uint size);
}
