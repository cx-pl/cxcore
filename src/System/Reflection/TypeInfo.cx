import System.Interop;

namespace System.Reflection;
public struct TypeInfo {
    public const ulong Hash;
    public const uint Flags;
    public const uint Size;
    public const string Name;
    public const string Namespace;
    public const TypeInfo[] GenericParams;
    public const TypeInfo? BaseType;
    public const TypeInfo[] Interfaces;
    public const uint GenericArity;
    public const FieldInfo[] Fields;
    public const FunctionInfo[] Functions;
    private ptr RuntimeTypeInfo;
    private ptr _module;

    /// Module defining this type, including the definition of a constructed generic type.
    @NoEscape public extern ModuleInfo GetModule() const;

    @NoEscape public extern bool IsAssignableFrom(const TypeInfo source) const;
    @NoEscape public extern bool IsSameType(const TypeInfo other) const;
    @NoEscape public extern bool IsInBaseTypeChain(const TypeInfo source) const;
    @NoEscape public extern bool HasRuntimeInterface(ulong typeHash) const;
    @NoEscape public extern object CreateInstance() const;
    public extern object CreateInstance(const object[] arguments) const;
    public extern object Invoke(object target, const string name, const object[] arguments) const;
    @NoEscape public extern FunctionInfo GetFunction(uint index) const;
    @NoEscape public extern bool CanInvokeFunction(uint index) const;
    public extern object InvokeFunction(object target, uint index, const object[] arguments) const;
    /// Converts compatible references or numeric constants, checking target ranges.
    @NoEscape
    public extern object ConvertValue(object value) const;
    @NoEscape public extern uint GetFunctionCount() const;
    @NoEscape public extern TypeInfo[] GetInterfaces() const;
    @NoEscape public extern uint GetFunctionFlags(uint functionIndex) const;
    @NoEscape public extern uint GetFunctionParameterCount(uint functionIndex) const;
    @NoEscape public extern TypeInfo GetFunctionParameterType(uint functionIndex, uint parameterIndex) const;
    @NoEscape public extern TypeInfo GetEnumerableElementType() const;
    @NoEscape public extern bool IsServiceSequence(object value) const;
    public extern object CreateCollectionFromSequence(object value) const;
    public extern object InvokeConstructor(uint functionIndex, const object[] arguments) const;
}
