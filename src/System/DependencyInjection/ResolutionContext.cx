import System.Collections;
import System.Reflection;
import System;

namespace System.DependencyInjection;
internal final class ResolutionContext {
    public List<uint> Slots;
    public List<TypeInfo> Keys;
    public uint SingletonDepth;
    public string CyclePath;

    public constructor() {
        Slots = new List<uint>();
        Keys = new List<TypeInfo>();
        SingletonDepth = 0u;
        CyclePath = null;
    }
}
