import System.Collections;
import System.Reflection;
import System;

namespace System.DependencyInjection;
internal final class ActivationPlan {
    public uint RegistrationSlot;
    public ServiceLifetime Lifetime;
    private TypeInfoHolder _implementationType;
    public TypeInfo ImplementationType { const get { return _implementationType.GetValue(); } }
    public uint FunctionIndex;
    public bool HasFunction;
    public Array<TypeInfoHolder> ParameterTypes;

    public constructor(
        uint registrationSlot,
        ServiceLifetime lifetime,
        TypeInfo implementationType,
        ConstructorSelection selection) {
        RegistrationSlot = registrationSlot;
        Lifetime = lifetime;
        _implementationType = new TypeInfoHolder(implementationType);
        FunctionIndex = selection.FunctionIndex;
        HasFunction = selection.HasFunction;
        uint parameterCount = HasFunction
            ? implementationType.GetFunctionParameterCount(FunctionIndex)
            : 0u;
        ParameterTypes = new Array<TypeInfoHolder>(parameterCount);
        for (uint index = 0u; index < parameterCount; index += 1u) {
            ParameterTypes.Set(index, new TypeInfoHolder(
                implementationType.GetFunctionParameterType(FunctionIndex, index)));
        }
    }
}
