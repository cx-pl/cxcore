import System.Collections;
import System.Reflection;
import System;

namespace System.DependencyInjection;
internal final class ServiceSequence {
    private List<object> _values;

    public constructor(List<object> values) {
        _values = values;
    }

    public uint GetCount() const {
        return _values.Count;
    }

    public object Get(uint index) const {
        return _values.Get(index);
    }
}
