namespace System.Threading.Tasks;

public delegate void CancellationCallback();

// Shared failure behavior keeps original exception identity across task types.
public struct VoidTask {
    private ptr _value;
    private bool _isCompleted;
    private bool _isFaulted;
    private Exception _exception;

    public bool IsCompleted { const get => _isCompleted; }
    public static extern void ThrowIfFaulted(bool isFaulted, Exception exception);
    public void GetResult() const { ThrowIfFaulted(_isFaulted, _exception); }

    public static VoidTask Faulted(Exception exception) {
        var task = new VoidTask();
        task._isFaulted = true;
        task._exception = exception;
        return task;
    }

    public constructor() {
        _value = null;
        _isCompleted = true;
        _isFaulted = false;
        _exception = null;
    }

    private constructor(bool isFaulted, Exception exception) {
        _value = null;
        _isCompleted = true;
        _isFaulted = isFaulted;
        _exception = exception;
    }
}

public class OperationCanceledException : Exception {
    private CancellationToken _cancellationToken;

    public CancellationToken CancellationToken {
        const get => _cancellationToken;
    }

    public constructor() : this(CancellationToken.None) { }

    public constructor(CancellationToken cancellationToken) : base() {
        _cancellationToken = cancellationToken;
    }

    public static void ThrowIfCanceled(
        bool isCanceled,
        CancellationToken cancellationToken) {
        if (isCanceled) {
            throw new OperationCanceledException(cancellationToken);
        }
    }
}

public struct CancellationToken {
    private CancellationTokenSource _source;

    public static CancellationToken None {
        const get { return new CancellationToken(null); }
    }

    public bool IsCancellationRequested {
        const get => _source != null && _source.IsCancellationRequested;
    }

    public void ThrowIfCancellationRequested() {
        OperationCanceledException.ThrowIfCanceled(
            IsCancellationRequested, new CancellationToken(_source));
    }

    public CancellationTokenRegistration Register(delegate() => void callback) {
        if (_source != null) {
            return _source.Register(callback);
        }
        return CancellationTokenRegistration.None;
    }

    internal constructor(CancellationTokenSource source) {
        _source = source;
    }
}

public struct CancellationTokenRegistration {
    private CancellationTokenSource _source;
    private uint _registrationId;

    public static CancellationTokenRegistration None {
        const get => new CancellationTokenRegistration(null, 0u);
    }

    public void Dispose() {
        if (_source != null) {
            _source.Unregister(_registrationId);
            _source = null;
            _registrationId = 0u;
        }
    }

    internal constructor(CancellationTokenSource source, uint registrationId) {
        _source = source;
        _registrationId = registrationId;
    }
}

public final class CancellationTokenSource {
    private bool _isCancellationRequested;
    private CancellationCallback[] _callbacks;
    private uint[] _callbackIds;
    private ptr[] _callbackArenas;
    private uint _callbackCount;
    private uint _nextCallbackId;

    public bool IsCancellationRequested {
        const get => _isCancellationRequested;
    }

    public CancellationToken Token { const get => new CancellationToken(this); }

    public CancellationTokenRegistration Register(delegate() => void callback) {
        if (_isCancellationRequested) {
            callback();
            return CancellationTokenRegistration.None;
        }

        TaskRuntime.RequireCancellationRegistrationAllowed();
        ptr callbackArena = TaskRuntime.CaptureCancellationCallbackArena();

        uint registrationId = _nextCallbackId;
        _nextCallbackId += 1u;
        if (_nextCallbackId == 0u) {
            _nextCallbackId = 1u;
        }
        CancellationCallback[] callbacks = null;
        uint[] callbackIds = null;
        ptr[] callbackArenas = null;
        bool registered = false;
        try {
            TaskRuntime.WithDurable(() => {
                callbacks = new CancellationCallback[_callbackCount + 1u];
                callbackIds = new uint[_callbackCount + 1u];
                callbackArenas = new ptr[_callbackCount + 1u];
                for (uint index = 0u; index < _callbackCount; index += 1u) {
                    TaskRuntime.StoreCancellationCallback(
                        callbacks, index, _callbacks[index], _callbackArenas[index]);
                    callbackIds[index] = _callbackIds[index];
                    callbackArenas[index] = _callbackArenas[index];
                }
                TaskRuntime.StoreCancellationCallback(
                    callbacks, _callbackCount, callback, callbackArena);
                callbackIds[_callbackCount] = registrationId;
                callbackArenas[_callbackCount] = callbackArena;
                _callbacks = callbacks;
                _callbackIds = callbackIds;
                _callbackArenas = callbackArenas;
            });
            registered = true;
        } finally {
            if (!registered && callbackArena != null) {
                TaskRuntime.ReleaseCancellationCallbackArena(callbackArena);
            }
        }
        _callbackCount += 1u;
        return new CancellationTokenRegistration(this, registrationId);
    }

    internal void Unregister(uint registrationId) {
        if (_isCancellationRequested || registrationId == 0u) {
            return;
        }
        for (uint index = 0u; index < _callbackCount; index += 1u) {
            if (_callbackIds[index] != registrationId) {
                continue;
            }
            ptr callbackArena = _callbackArenas[index];
            TaskRuntime.StoreCancellationCallback(
                _callbacks, index, null, callbackArena);
            _callbackIds[index] = 0u;
            _callbackArenas[index] = null;
            if (callbackArena != null) {
                TaskRuntime.ReleaseCancellationCallbackArena(callbackArena);
            }
            return;
        }
    }

    public void Cancel() {
        if (_isCancellationRequested) {
            return;
        }
        _isCancellationRequested = true;
        CancellationCallback[] callbacks = _callbacks;
        ptr[] callbackArenas = _callbackArenas;
        uint callbackCount = _callbackCount;
        _callbacks = null;
        _callbackIds = null;
        _callbackArenas = null;
        _callbackCount = 0u;
        Exception firstException = null;
        for (uint index = 0u; index < callbackCount; index += 1u) {
            try {
                if (callbacks[index] != null) {
                    TaskRuntime.InvokeCancellationCallback(
                        callbacks[index], callbackArenas[index]);
                }
            } catch (Exception exception) {
                if (firstException == null) {
                    firstException = exception;
                }
            } finally {
                ptr callbackArena = callbackArenas[index];
                TaskRuntime.StoreCancellationCallback(
                    callbacks, index, null, callbackArena);
                callbackArenas[index] = null;
                if (callbackArena != null) {
                    TaskRuntime.ReleaseCancellationCallbackArena(callbackArena);
                }
            }
        }
        if (firstException != null) {
            throw firstException;
        }
    }

    public constructor() {
        _isCancellationRequested = false;
        _callbacks = new CancellationCallback[0u];
        _callbackIds = new uint[0u];
        _callbackArenas = new ptr[0u];
        _callbackCount = 0u;
        _nextCallbackId = 1u;
    }
}

public final class TaskHandle {
    private TaskState _state;

    public bool IsCompleted { const get => _state.IsCompleted; }
    public bool IsCanceled { const get => _state.IsCanceled; }
    public void GetResult() const {
        TaskState.ThrowIfNotCompleted(_state.IsCompleted);
        _state.MarkFaultObserved();
        OperationCanceledException.ThrowIfCanceled(
            _state.IsCanceled, CancellationToken.None);
        VoidTask.ThrowIfFaulted(_state.IsFaulted, _state.Exception);
    }

    public static TaskHandle Faulted(Exception exception) {
        var task = new TaskHandle(false);
        task.SetFault(exception);
        return task;
    }

    public static TaskHandle Delay(uint milliseconds) {
        var completion = new TaskCompletionSourceVoid();
        TaskScheduler.PostAfter(milliseconds, () => completion.SetResult());
        return completion.Task;
    }

    public static TaskHandle Delay(
        uint milliseconds,
        CancellationToken cancellationToken) {
        var completion = new TaskCompletionSourceVoid();
        if (cancellationToken.IsCancellationRequested) {
            completion.SetCanceled();
            return completion.Task;
        }

        CancellationTokenRegistration cancellationRegistration =
            CancellationTokenRegistration.None;
        cancellationRegistration = cancellationToken.Register(() => {
            if (!completion.Task.IsCompleted) {
                completion.SetCanceled();
            }
        });
        TaskScheduler.PostAfter(milliseconds, () => {
            if (!completion.Task.IsCompleted) {
                completion.SetResult();
            }
            cancellationRegistration.Dispose();
        });
        return completion.Task;
    }

    // Completes only after every input completes, even when a child faults or
    // is canceled. This keeps a scoped async parent from finishing while a
    // sibling child still owns arena references.
    public static TaskHandle WhenAll(TaskHandle first, TaskHandle second) {
        TaskHandle[] children = new TaskHandle[2u];
        children[0u] = first;
        children[1u] = second;
        return WhenAll(children);
    }

    // A variable-size overload lets an async arena join every child started by
    // an operation, rather than relying on pairwise completion as a lifetime
    // proof.
    public static TaskHandle WhenAll(TaskHandle[] children) {
        TaskHandleWhenAllState state = new TaskHandleWhenAllState(children);
        state.Start();
        return state.Task;
    }

    public void SetResult() { _state.SetResult(null); }
    public void SetFault(Exception exception) { _state.SetFault(exception); }
    public void SetCanceled() { _state.SetCanceled(); }
    public extern void OnCompleted(delegate() => void continuation);

    public constructor() {
        _state = new TaskState();
        _state.SetResult(null);
    }

    internal constructor(bool completed) {
        _state = new TaskState();
        if (completed) _state.SetResult(null);
    }
}

alias Task = TaskHandle;

internal final class TaskHandleWhenAllState {
    private TaskHandle[] _children;
    private TaskHandle _completion;
    private uint _remaining;
    private Exception _firstException;
    private bool _wasCanceled;

    public TaskHandle Task { const get => _completion; }

    public constructor(TaskHandle[] children) {
        if (children == null) {
            throw new Exception("TaskHandle.WhenAll requires a child array.");
        }
        _children = new TaskHandle[children.Length];
        for (uint index = 0u; index < children.Length; index += 1u) {
            if (children[index] == null) {
                throw new Exception("TaskHandle.WhenAll child entries cannot be null.");
            }
            _children[index] = children[index];
        }
        _completion = new TaskHandle(false);
        _remaining = children.Length;
        _firstException = null;
        _wasCanceled = false;
    }

    public void Start() {
        if (_remaining == 0u) {
            _completion.SetResult();
            return;
        }
        uint count = _remaining;
        for (uint index = 0u; index < count; index += 1u) {
            RegisterChild(index);
        }
    }

    private void RegisterChild(uint index) {
        TaskHandle child = _children[index];
        child.OnCompleted(() => this.Complete(index));
    }

    private void Complete(uint index) {
        TaskHandle child = _children[index];
        if (child.IsCanceled) {
            _wasCanceled = true;
        } else {
            try {
                child.GetResult();
            } catch (Exception exception) {
                if (_firstException == null) {
                    _firstException = exception;
                }
            }
        }

        _remaining -= 1u;
        if (_remaining != 0u) {
            return;
        }
        if (_firstException != null) {
            _completion.SetFault(_firstException);
        } else if (_wasCanceled) {
            _completion.SetCanceled();
        } else {
            _completion.SetResult();
        }
    }
}

// TaskState keeps all completion data in a non-generic, GC-visible object.
// Task<T> is therefore a stable object layout across modules and specializations.
internal final class TaskState {
    private object _value;
    private bool _isCompleted;
    private bool _isFaulted;
    private bool _isCanceled;
    private Exception _exception;
    private ptr _continuations;

    public bool IsCompleted { const get => _isCompleted; }
    public object Value { const get => _value; }
    public bool IsFaulted { const get => _isFaulted; }
    public bool IsCanceled { const get => _isCanceled; }
    public Exception Exception { const get => _exception; }
    public static extern void RegisterUnobservedFault(TaskState state);
    public extern void MarkFaultObserved();

    public static extern void ThrowIfNotCompleted(bool isCompleted);
    public static extern void ThrowIfAlreadyCompleted(bool isCompleted);
    public extern void OnCompleted(delegate() => void continuation);
    private extern void ScheduleContinuations();

    public void SetResult(object value) {
        ThrowIfAlreadyCompleted(_isCompleted);
        _value = value;
        _isFaulted = false;
        _isCompleted = true;
        ScheduleContinuations();
    }

    public extern void SetFault(Exception exception);

    public void SetCanceled() {
        ThrowIfAlreadyCompleted(_isCompleted);
        _isFaulted = false;
        _isCanceled = true;
        _isCompleted = true;
        ScheduleContinuations();
    }

    public constructor() {
        _value = null;
        _isCompleted = false;
        _isFaulted = false;
        _isCanceled = false;
        _exception = null;
        _continuations = null;
    }
}

public class Task<T> {
    private bool _isCompleted;
    private bool _isFaulted;
    private bool _isCanceled;
    private Exception _exception;
    private ptr _continuations;
    private T _result;

    public bool IsCompleted { const get => _isCompleted; }
    public bool IsCanceled { const get => _isCanceled; }
    public T GetResult() const {
        TaskState.ThrowIfNotCompleted(_isCompleted);
        TaskRuntime.MarkFaultObserved(this);
        OperationCanceledException.ThrowIfCanceled(
            _isCanceled, CancellationToken.None);
        VoidTask.ThrowIfFaulted(_isFaulted, _exception);
        return _result;
    }

    public constructor(T result) {
        _result = result;
        _isCompleted = true;
    }

    public constructor() { }

    public void SetResult(T result) {
        TaskRuntime.ThrowIfAlreadyCompleted(this);
        _result = result;
        CompleteStoredResult();
    }

    internal void StoreResultValue(T result) {
        TaskRuntime.ThrowIfAlreadyCompleted(this);
        _result = result;
    }

    internal void CompleteStoredResult() {
        TaskRuntime.ThrowIfAlreadyCompleted(this);
        _isFaulted = false;
        _isCanceled = false;
        _exception = null;
        _isCompleted = true;
        TaskRuntime.ScheduleContinuations(this);
    }
    public void SetFault(Exception exception) {
        TaskRuntime.SetFault(this, exception);
    }
    public void SetCanceled() { TaskRuntime.SetCanceled(this); }
    public void OnCompleted(delegate() => void continuation) {
        TaskRuntime.OnCompleted(this, continuation);
    }
}

public struct ValueTask<T> {
    private Task<T> _task;
    private ReusableValueTaskSource<T> _source;
    private uint _version;
    private bool _hasSource;
    private bool _consumed;
    private T _result;

    public bool IsCompleted { const get => _hasSource
        ? TaskRuntime.ReusableSourceIsCompleted(_source, _version)
        : _task == null || _task.IsCompleted; }

    public T GetResult() {
        TaskState.ThrowIfAlreadyCompleted(_consumed);
        _consumed = true;
        if (_hasSource) { return _source.GetResult(_version); }
        if (_task != null) { return _task.GetResult(); }
        return _result;
    }

    public Task<T> AsTask() {
        TaskState.ThrowIfAlreadyCompleted(_consumed);
        _consumed = true;
        if (_hasSource) {
            var completion = new TaskCompletionSource<T>();
            var source = _source;
            var version = _version;
            source.OnCompleted(version, () => {
                try {
                    completion.SetResult(source.GetResult(version));
                } catch (OperationCanceledException) {
                    completion.SetCanceled();
                } catch (Exception exception) {
                    completion.SetException(exception);
                }
            });
            return completion.GetTask();
        }
        if (_task != null) { return _task; }
        return new Task<T>(_result);
    }

    public void OnCompleted(delegate() => void continuation) {
        if (_hasSource) { _source.OnCompleted(_version, continuation); }
        else if (_task != null) { _task.OnCompleted(continuation); }
    }

    public void SetTask(Task<T> task) {
        _task = task;
        _source = null;
        _version = 0u;
        _hasSource = false;
        _consumed = false;
    }
    public void SetSource(ReusableValueTaskSource<T> source, uint version) {
        _task = null;
        _source = source;
        _version = version;
        _hasSource = true;
        _consumed = false;
    }
    public constructor(T result) {
        _result = result;
        _consumed = false;
    }
    public constructor() { }
}

// A reusable value source permits one continuation per generation. Reset is
// valid only after consumption and scheduler acknowledgment of that callback.
public struct ReusableValueTask<T> {
    private ReusableValueTaskSource<T> _source;
    private uint _version;

    public bool IsCompleted {
        const get => TaskRuntime.ReusableSourceIsCompleted(_source, _version);
    }
    public T GetResult() { return _source.GetResult(_version); }
    public Task<T> AsTask() {
        var completion = new TaskCompletionSource<T>();
        var source = _source;
        var version = _version;
        source.OnCompleted(version, () => {
            try {
                completion.SetResult(source.GetResult(version));
            } catch (OperationCanceledException) {
                completion.SetCanceled();
            } catch (Exception exception) {
                completion.SetException(exception);
            }
        });
        return completion.Task;
    }
    public void OnCompleted(delegate() => void continuation) {
        _source.OnCompleted(_version, continuation);
    }

    public void SetSource(ReusableValueTaskSource<T> source, uint version) {
        _source = source;
        _version = version;
    }

    public constructor() {
        _source = null;
        _version = 0u;
    }
}

internal final class ReusableValueTaskContinuationState {
    private delegate() => void _continuation;
    // Keep the acknowledged scheduler node with this reusable source state.
    private object _schedulerItem;
    // Lease captured when the continuation is registered. The scheduler takes
    // ownership when the completed source queues its reusable callback.
    private ptr _logicalArena;

    public extern void Clear();

    public extern constructor();
}

public final class ReusableValueTaskSource<T> {
    private uint _version;
    private bool _isCompleted;
    private bool _isConsumed;
    private bool _isRetired;
    private uint _pendingCallbacks;
    private bool _continuationRegistered;
    private ReusableValueTaskContinuationState _continuationState;
    // A library can retain opaque native wait state across source generations.
    // It is shared with the source owner, not a single native operation.
    private object _nativeWaitState;
    private T _result;
    private Exception _exception;
    private bool _isFaulted;
    private bool _isCanceled;

    private void ThrowIfStale(uint version) {
        TaskState.ThrowIfAlreadyCompleted(_isRetired || version != _version);
    }

    public T GetResult(uint version) {
        ThrowIfStale(version);
        TaskState.ThrowIfNotCompleted(_isCompleted);
        TaskState.ThrowIfAlreadyCompleted(_isConsumed);
        _isConsumed = true;
        OperationCanceledException.ThrowIfCanceled(
            _isCanceled, CancellationToken.None);
        VoidTask.ThrowIfFaulted(_isFaulted, _exception);
        return _result;
    }

    public bool IsCompleted { const get => _isCompleted; }

    public void SetResult(T result) {
        SetResult(_version, result);
    }

    // Native callbacks capture their generation when the operation is armed.
    // They must complete that generation rather than whichever operation now
    // occupies this reusable source.
    public void SetResult(uint version, T result) {
        ThrowIfStale(version);
        TaskState.ThrowIfAlreadyCompleted(_isRetired || _isCompleted);
        _result = result;
        _exception = null;
        _isFaulted = false;
        _isCanceled = false;
        _isCompleted = true;
        TaskRuntime.ScheduleReusableSourceContinuation(this, _version);
    }

    public void SetException(Exception exception) {
        SetException(_version, exception);
    }

    public void SetException(uint version, Exception exception) {
        ThrowIfStale(version);
        TaskState.ThrowIfAlreadyCompleted(_isRetired || _isCompleted);
        _result = default;
        _exception = exception;
        _isFaulted = true;
        _isCanceled = false;
        _isCompleted = true;
        TaskRuntime.ScheduleReusableSourceContinuation(this, _version);
    }

    public void SetCanceled() {
        SetCanceled(_version);
    }

    public void SetCanceled(uint version) {
        ThrowIfStale(version);
        TaskState.ThrowIfAlreadyCompleted(_isRetired || _isCompleted);
        _result = default;
        _exception = null;
        _isFaulted = false;
        _isCanceled = true;
        _isCompleted = true;
        TaskRuntime.ScheduleReusableSourceContinuation(this, _version);
    }

    public void OnCompleted(uint version, delegate() => void continuation) {
        ThrowIfStale(version);
        TaskState.ThrowIfAlreadyCompleted(_isConsumed || _continuationRegistered);
        if (_continuationState == null) {
            _continuationState = new ReusableValueTaskContinuationState();
        }
        TaskRuntime.RegisterReusableSourceContinuation(this, version, continuation);
    }

    public void Reset() {
        TaskState.ThrowIfAlreadyCompleted(
            _isRetired || !_isCompleted || !_isConsumed || _pendingCallbacks != 0u);
        _result = default;
        _exception = null;
        _isFaulted = false;
        _isCanceled = false;
        _isCompleted = false;
        _isConsumed = false;
        _continuationRegistered = false;
        if (_continuationState != null) { _continuationState.Clear(); }
        if (_version == 4294967295u) {
            _isRetired = true;
            return;
        }
        _version += 1u;
    }

    public uint GetVersion() { return _version; }

    public constructor() { }
}

// Default(ValueTask) is an inline successful completion. Exceptional,
// canceled, and pending operations use a persistent TaskHandle.
public struct ValueTaskHandle {
    private TaskHandle _task;
    private bool _hasTask;
    private bool _consumed;

    public bool IsCompleted { const get => !_hasTask || _task.IsCompleted; }

    public void GetResult() {
        TaskState.ThrowIfAlreadyCompleted(_consumed);
        _consumed = true;
        if (_hasTask) {
            _task.GetResult();
        }
    }

    public TaskHandle AsTask() {
        TaskState.ThrowIfAlreadyCompleted(_consumed);
        _consumed = true;
        if (_hasTask) {
            return _task;
        }
        return new TaskHandle();
    }

    public void OnCompleted(delegate() => void continuation) {
        if (_hasTask) { _task.OnCompleted(continuation); }
    }

    public constructor() {
        _task = null;
        _hasTask = false;
        _consumed = false;
    }

    public constructor(TaskHandle task) {
        _task = task;
        _hasTask = true;
        _consumed = false;
    }
}

alias ValueTask = ValueTaskHandle;

public struct TaskCompletionSource<T> {
    private Task<T> _task;
    public Task<T> Task { const get => _task; }
    public Task<T> GetTask() { return _task; }
    public void SetResult(T result) { _task.SetResult(result); }
    public void SetException(Exception exception) { _task.SetFault(exception); }
    public void SetCanceled() { _task.SetCanceled(); }
    public constructor() { _task = new Task<T>(); }
}

public final class TaskCompletionSourceVoid {
    private TaskHandle _task;

    public TaskHandle Task { const get => _task; }

    public void SetResult() { _task.SetResult(); }
    public void SetException(Exception exception) { _task.SetFault(exception); }
    public void SetCanceled() { _task.SetCanceled(); }

    public constructor() { _task = new TaskHandle(false); }
}

alias TaskCompletionSource = TaskCompletionSourceVoid;

// Shared native plumbing keeps forwarding independent of the generic result ABI.
public static class TaskRuntime {
    public static extern void RequireAsyncUseAllowed();
    internal static extern void WithDurable(delegate() => void action);
    internal static extern void RequireCancellationRegistrationAllowed();
    internal static extern ptr CaptureCancellationCallbackArena();
    internal static extern void StoreCancellationCallback(
        CancellationCallback[] callbacks,
        uint index,
        CancellationCallback callback,
        ptr logicalArena);
    internal static extern void InvokeCancellationCallback(
        CancellationCallback callback,
        ptr logicalArena);
    internal static extern void ReleaseCancellationCallbackArena(ptr logicalArena);
    public static extern void OnCompleted(object task, delegate() => void continuation);
    public static extern void ThrowIfAlreadyCompleted(object task);
    public static extern void ScheduleContinuations(object task);
    public static extern void MarkFaultObserved(object task);
    public static extern void SetFault(object task, Exception exception);
    public static extern void SetCanceled(object task);
    public static extern void ForwardVoid(object source, object destination);
    public static extern bool ReusableSourceIsCompleted(object source, uint version);
    public static extern void RegisterReusableSourceContinuation(
        object source,
        uint version,
        delegate() => void continuation);
    public static extern void ScheduleReusableSourceContinuation(
        object source,
        uint version);
    internal static extern object GetReusableSourceNativeWaitState(object source);
    internal static extern void SetReusableSourceNativeWaitState(
        object source,
        object item);
    public static extern object GetVoidTask(object source);

}
