namespace System;

public struct DateTime {
    private long _milliseconds;
    private short _offset;

    public long Milliseconds {
        const get { 
            return _milliseconds; 
        }  
    }

    public short Offset {
        const get { 
            return _offset; 
        }  
    }

    public long Year {
        const get {
            const long gregorianCycleDays = 146097;
            long cycles = TotalDays / gregorianCycleDays;
            long remDays = TotalDays % gregorianCycleDays;
            long currentYear = cycles * 400 + 1;

            while (true) {
                long daysInYear = IsLeapYear(currentYear) ? 366 : 365;
                if (remDays >= daysInYear) {
                    remDays -= daysInYear;
                    currentYear++;
                } else {
                    break;
                }
            }

            return currentYear;
        } 
    }

    public long Month {
        const get {
            const long gregorianCycleDays = 146097;
            long cycles = TotalDays / gregorianCycleDays;
            long remDays = TotalDays % gregorianCycleDays;
            long currentYear = cycles * 400 + 1;

            while (true) {
                long daysInYear = IsLeapYear(currentYear) ? 366 : 365;
                if (remDays >= daysInYear) {
                    remDays -= daysInYear;
                    currentYear++;
                } else {
                    break;
                }
            }

            long currentMonth = 1;
            while (remDays >= DaysInMonth(currentMonth, currentYear)) {
                remDays -= DaysInMonth(currentMonth, currentYear);
                currentMonth++;
            }

            return currentMonth;
        }
    }

    public long Day {
        const get {
            const long gregorianCycleDays = 146097;
            long cycles = TotalDays / gregorianCycleDays;
            long remDays = TotalDays % gregorianCycleDays;
            long currentYear = cycles * 400 + 1;

            while (true) {
                long daysInYear = IsLeapYear(currentYear) ? 366 : 365;
                if (remDays >= daysInYear) {
                    remDays -= daysInYear;
                    currentYear++;
                } else {
                    break;
                }
            }

            long currentMonth = 1;
            while (remDays >= DaysInMonth(currentMonth, currentYear)) {
                remDays -= DaysInMonth(currentMonth, currentYear);
                currentMonth++;
            }

            return remDays + 1;
        }
    }

    public long DayOfWeek {
        const get {
            return (TotalDays + 1) % 7;
        } 
    }

    public long Hour {
        const get {
            return TotalHours % 24;
        } 
    }

    public long Minute {
        const get {
            return TotalMinutes % 60;
        } 
    }

    public long Second {
        const get {
            return TotalSeconds % 60;
        } 
    }

    public long Millisecond {
        const get {
            return _milliseconds % 1000;
        } 
    }

    public long TotalDays { 
        const get {
            return _milliseconds / (24 * 60 * 60 * 1000);
        } 
    }

    public long TotalHours { 
        const get {
            return _milliseconds / (60 * 60 * 1000);
        } 
    }

    public long TotalMinutes { 
        const get {
            return _milliseconds / (60 * 1000);
        } 
    }

    public long TotalSeconds { 
        const get {
            return _milliseconds / 1000;
        } 
    }

    public static long DaysInMonth(long month, long year) {
        switch (month) {
            case 1l: // January
                return 31;
            case 2l: // February
                return IsLeapYear(year) ? 29 : 28;
            case 3l: // March
                return 31;
            case 4l: // April
                return 30;
            case 5l: // May
                return 31;
            case 6l: // June
                return 30;
            case 7l: // July
                return 31;
            case 8l: // August
                return 31;
            case 9l: // September
                return 30;
            case 10l: // October
                return 31;
            case 11l: // November
                return 30;
            case 12l: // December
                return 31;
            default: // Argument out of range
                return 0;
        }
    }

    public static bool IsLeapYear(long year) {
        return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
    }

    public constructor(long milliseconds, short offset = 0) {
        _milliseconds = milliseconds;
        _offset = offset;
    }

    public extern constructor(
        int year, 
        int month, 
        int day, 
        int hour, 
        int minute, 
        int second, 
        int millisecond,
        short offset
    );

    public DateTime AddYears(long years) const {
        return AddMonths(years * 12);
    }

    public DateTime AddMonths(long months) const {
        long days = months * 30; // TODO: add support for different number of days per month

        return new DateTime(_milliseconds + days * (24 * 60 * 60 * 1000), _offset);
    }

    public DateTime AddDays(long days) const {
        return new DateTime(_milliseconds + days * (24 * 60 * 60 * 1000), _offset);
    }

    public DateTime AddHours(long hours) const {
        return new DateTime(_milliseconds + hours * (60 * 60 * 1000), _offset);
    }

    public DateTime AddMinutes(long minutes) const {
        return new DateTime(_milliseconds + minutes * (60 * 1000), _offset);
    }    

    public DateTime AddSeconds(long seconds) const {
        return new DateTime(_milliseconds + seconds * 1000, _offset);
    }

    public DateTime AddMilliseconds(long milliseconds) const {
        return new DateTime(_milliseconds + milliseconds, _offset);
    }
}
