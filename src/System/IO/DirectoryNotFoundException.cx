namespace System.IO;
public class DirectoryNotFoundException : IOException {
    public constructor() : this(null) { }
    public constructor(const string message)
        : base(message ?? "The specified directory was not found.") { }
    public constructor(const string message, const System.Exception innerException)
        : base(message ?? "The specified directory was not found.", innerException) { }
    public constructor(const string message, const string path)
        : base(message ?? "The specified directory was not found.", null,
            path, null, 0) { }
}
