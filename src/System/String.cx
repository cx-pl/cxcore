namespace System;

public final class String : Object {
    private uint _length;
    private ptr _data;

    public static const String Empty { extern const get; }
    public uint Length { extern const get; }
    public char Item {
        extern const get(uint index);
    }

    public override extern string ToString() const;
    public override extern bool Equals(object other) const;
    public override extern int GetHashCode() const;
    public extern bool operator ==(string other) const;
    public extern bool operator !=(string other) const;
    public extern bool operator <(string other) const;
    public extern bool operator <=(string other) const;
    public extern bool operator >(string other) const;
    public extern bool operator >=(string other) const;

    // public static extern string Format(const string format, params const object[] args);
    private extern constructor();
    private extern constructor(uint length, ptr data);
    public extern constructor(uint length, char ch);
    // TODO: public extern IEnumerator<char> GetEnumerator() const;
}
