namespace System.Collections;

public final class Queue<T> : IEnumerable<T> {
    private List<T> _items;

    public uint Count { const get { return _items.Count; } }

    public IEnumerator<T> GetEnumerator() const {
        return _items.GetEnumerator();
    }

    public constructor() {
        _items = new List<T>();
    }

    public void Enqueue(T value) {
        _items.Add(value);
    }

    public T Peek() const {
        return _items.Get(0u);
    }

    public T Dequeue() {
        T value = _items.Get(0u);
        _items.RemoveAt(0u);
        return value;
    }

    public void Clear() {
        _items.Clear();
    }

}
