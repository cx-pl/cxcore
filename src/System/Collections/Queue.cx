namespace System.Collections;

public final class Queue<T> : ICollection<T> {
    private List<T> _items;
    private uint _count;

    public uint Count { const get { return _count; } }

    public IEnumerator<T> GetEnumerator() const {
        return _items.GetEnumerator();
    }

    public constructor() {
        _items = new List<T>();
    }

    public void Enqueue(T value) {
        _items.Add(value);
        _count += 1u;
    }

    public T Peek() const {
        return _items.Get(0u);
    }

    public T Dequeue() {
        T value = _items.Get(0u);
        _items.RemoveAt(0u);
        _count -= 1u;
        return value;
    }

    public void Clear() {
        _items.Clear();
        _count = 0u;
    }

}
