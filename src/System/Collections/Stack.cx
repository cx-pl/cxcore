namespace System.Collections;

public final class Stack<T> : ICollection<T> {
    private List<T> _items;
    private uint _count;

    public uint Count { const get { return _count; } }

    public IEnumerator<T> GetEnumerator() const {
        return _items.GetReverseEnumerator();
    }

    public constructor() {
        _items = new List<T>();
    }

    public void Push(T value) {
        _items.Add(value);
        _count += 1u;
    }

    public T Peek() const {
        return _items.Get(_items.Count - 1u);
    }

    public T Pop() {
        uint last = _items.Count - 1u;
        T value = _items.Get(last);
        _items.RemoveAt(last);
        _count -= 1u;
        return value;
    }

    public void Clear() {
        _items.Clear();
        _count = 0u;
    }

}
