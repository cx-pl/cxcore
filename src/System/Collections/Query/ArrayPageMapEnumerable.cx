import System.Collections;

namespace System.Collections.Query;
public final class ArrayPageMapEnumerable<T, TResult> : IEnumerable<TResult> {
    internal ArrayPageEnumerable<T> _source;
    internal delegate(T) => TResult _selector;

    internal constructor(
        ArrayPageEnumerable<T> source,
        delegate(T) => TResult selector) {
        _source = source;
        _selector = selector;
    }

    public IEnumerator<TResult> GetEnumerator() const {
        return new IndexedPageMapEnumerator<T, TResult>(
            _source._source, _selector,
            _source._offset < _source._source.Length
                ? _source._offset : _source._source.Length,
            (_source._offset < _source._source.Length
                ? _source._offset : _source._source.Length) +
                (_source._pageSize < _source._source.Length -
                    (_source._offset < _source._source.Length
                        ? _source._offset : _source._source.Length)
                    ? _source._pageSize
                    : _source._source.Length -
                        (_source._offset < _source._source.Length
                            ? _source._offset : _source._source.Length)));
    }
}
