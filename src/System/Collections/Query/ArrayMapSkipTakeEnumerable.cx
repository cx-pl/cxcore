import System.Collections;

namespace System.Collections.Query;
public final class ArrayMapSkipTakeEnumerable<T, TResult>
    : IEnumerable<TResult> {
    private ArrayMapSkipEnumerable<T, TResult> _source;
    private uint _count;

    internal constructor(
        ArrayMapSkipEnumerable<T, TResult> source,
        uint count) {
        _source = source;
        _count = count;
    }

    public IEnumerator<TResult> GetEnumerator() const {
        return new IndexedMapSkipTakeEnumerator<T, TResult>(
            _source._source._source, _source._source._selector,
            _source._source._source.Length, _source._skip, _count);
    }
}
