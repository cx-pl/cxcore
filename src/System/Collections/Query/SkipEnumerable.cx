import System.Collections;

namespace System.Collections.Query;
/// <summary>A deferred offset over an enumerable source.</summary>
public final class SkipEnumerable<T> : IEnumerable<T> {
    private IEnumerable<T> _source;
    private uint _count;

    internal constructor(IEnumerable<T> source, uint count) {
        _source = source;
        _count = count;
    }

    public IEnumerator<T> GetEnumerator() const {
        return new SkipEnumerator<T>(_source.GetEnumerator(), _count);
    }
}
