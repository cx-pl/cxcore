import System.Collections;
import System.Threading.Tasks;

namespace System.Collections.Query;
/// <summary>
/// A provider query plan. It is deliberately not IEnumerable; executing it or
/// converting it to a local sequence must be an explicit provider operation.
/// Source contains the provider-owned input payload on a source node and the
/// preceding plan node on an operator node.
/// </summary>
public final class QueryPlan<T> : IQueryPlanNode {
    private string _kind;
    private string _sourceName;
    private object _source;
    private object _expression;
    private uint _count;
    private uint _secondCount;

    public string Kind { const get { return _kind; } }
    public string SourceName { const get { return _sourceName; } }
    public object Source { const get { return _source; } }
    public object Expression { const get { return _expression; } }
    public uint Count { const get { return _count; } }
    public uint SecondCount { const get { return _secondCount; } }

    public constructor(
        string kind,
        string sourceName,
        object source,
        object expression,
        uint count,
        uint secondCount) {
        _kind = kind;
        _sourceName = sourceName;
        _source = source;
        _expression = expression;
        _count = count;
        _secondCount = secondCount;
    }

    public QueryPlan<T> Filter(QueryLambda<T, bool> predicate) {
        return new QueryPlan<T>(
            "Filter", null, this, predicate, 0u, 0u);
    }

    public QueryPlan<TResult> Select<TResult>(
        QueryLambda<T, TResult> selector) {
        return new QueryPlan<TResult>(
            "Select", null, this, selector, 0u, 0u);
    }

    public QueryPlan<T> OrderBy<TKey>(
        QueryLambda<T, TKey> keySelector) {
        return new QueryPlan<T>(
            "OrderBy", null, this, keySelector, 0u, 0u);
    }

    public QueryPlan<T> OrderByDescending<TKey>(
        QueryLambda<T, TKey> keySelector) {
        return new QueryPlan<T>(
            "OrderByDescending", null, this, keySelector, 0u, 0u);
    }

    public QueryPlan<T> ThenOrderBy<TKey>(
        QueryLambda<T, TKey> keySelector) {
        return new QueryPlan<T>(
            "ThenOrderBy", null, this, keySelector, 0u, 0u);
    }

    public QueryPlan<T> ThenOrderByDescending<TKey>(
        QueryLambda<T, TKey> keySelector) {
        return new QueryPlan<T>(
            "ThenOrderByDescending", null, this, keySelector, 0u, 0u);
    }

    /// <summary>Provider-expression counterpart to local Map.</summary>
    public QueryPlan<TResult> Map<TResult>(
        QueryLambda<T, TResult> selector) {
        return new QueryPlan<TResult>(
            "Select", null, this, selector, 0u, 0u);
    }

    /// <summary>Provider-expression counterpart to local Sort.</summary>
    public QueryPlan<T> Sort<TKey>(QueryLambda<T, TKey> keySelector) {
        return new QueryPlan<T>(
            "OrderBy", null, this, keySelector, 0u, 0u);
    }

    /// <summary>Provider-expression counterpart to local SortDescending.</summary>
    public QueryPlan<T> SortDescending<TKey>(
        QueryLambda<T, TKey> keySelector) {
        return new QueryPlan<T>(
            "OrderByDescending", null, this, keySelector, 0u, 0u);
    }

    /// <summary>Provider-expression counterpart to local ThenSort.</summary>
    public QueryPlan<T> ThenSort<TKey>(QueryLambda<T, TKey> keySelector) {
        return new QueryPlan<T>(
            "ThenOrderBy", null, this, keySelector, 0u, 0u);
    }

    /// <summary>Provider-expression counterpart to local ThenSortDescending.</summary>
    public QueryPlan<T> ThenSortDescending<TKey>(
        QueryLambda<T, TKey> keySelector) {
        return new QueryPlan<T>(
            "ThenOrderByDescending", null, this, keySelector, 0u, 0u);
    }

    public QueryPlan<T> Skip(uint count) {
        return new QueryPlan<T>(
            "Skip", null, this, null, count, 0u);
    }

    public QueryPlan<T> Take(uint count) {
        return new QueryPlan<T>(
            "Take", null, this, null, count, 0u);
    }

    public QueryPlan<T> Page(uint pageIndex, uint pageSize) {
        if (pageSize != 0u && pageIndex > 4294967295u / pageSize) {
            throw new System.ArgumentOutOfRangeException("pageIndex");
        }
        uint offset = pageIndex * pageSize;
        return new QueryPlan<T>(
            "Page", null, this, null, offset, pageSize);
    }

    /// <summary>Creates an external-provider scalar terminal.</summary>
    public QueryScalarPlan<bool> Any() {
        return new QueryScalarPlan<bool>("Any", this, 0u);
    }

    /// <summary>Creates an external-provider scalar terminal with a predicate.</summary>
    public QueryScalarPlan<bool> Any(QueryLambda<T, bool> predicate) {
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return Filter(predicate).Any();
    }

    /// <summary>Creates an external-provider scalar terminal.</summary>
    public QueryScalarPlan<uint> Count() {
        return new QueryScalarPlan<uint>("Count", this, 0u);
    }

    /// <summary>Creates an external-provider scalar terminal with a predicate.</summary>
    public QueryScalarPlan<uint> Count(QueryLambda<T, bool> predicate) {
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return Filter(predicate).Count();
    }

    public QueryScalarPlan<T> First() {
        return new QueryScalarPlan<T>("First", this, 0u);
    }

    public QueryScalarPlan<T> FirstOrDefault() {
        return new QueryScalarPlan<T>("FirstOrDefault", this, 0u);
    }

    public QueryScalarPlan<T> Last() {
        return new QueryScalarPlan<T>("Last", this, 0u);
    }

    public QueryScalarPlan<T> LastOrDefault() {
        return new QueryScalarPlan<T>("LastOrDefault", this, 0u);
    }

    public QueryScalarPlan<T> Single() {
        return new QueryScalarPlan<T>("Single", this, 0u);
    }

    public QueryScalarPlan<T> SingleOrDefault() {
        return new QueryScalarPlan<T>("SingleOrDefault", this, 0u);
    }

    public QueryScalarPlan<T> ElementAt(uint index) {
        return new QueryScalarPlan<T>("ElementAt", this, index);
    }

    public QueryScalarPlan<T> ElementAtOrDefault(uint index) {
        return new QueryScalarPlan<T>("ElementAtOrDefault", this, index);
    }
}
