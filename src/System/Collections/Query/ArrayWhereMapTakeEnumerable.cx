import System.Collections;

namespace System.Collections.Query;
public final class ArrayWhereMapTakeEnumerable<T, TResult> : IEnumerable<TResult> {
    private ArrayWhereMapEnumerable<T, TResult> _source;
    private uint _count;

    internal constructor(
        ArrayWhereMapEnumerable<T, TResult> source,
        uint count) {
        _source = source;
        _count = count;
    }

    public IEnumerator<TResult> GetEnumerator() const {
        return new ArrayWhereMapEnumerator<T, TResult>(
            _source._source._source, _source._source._predicate,
            _source._selector, _source._source._source.Length,
            _count);
    }
}
