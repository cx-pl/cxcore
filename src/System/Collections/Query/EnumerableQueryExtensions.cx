import System.Collections;

namespace System.Collections.Query;

/// <summary>Deferred, synchronous query operators for local enumerable sources.</summary>
public extension EnumerableQueryExtensions<T> : IEnumerable<T> {
    public WhereEnumerable<T> Filter(delegate(T) => bool predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new WhereEnumerable<T>(this, predicate);
    }

    public SelectEnumerable<T, TResult> Map<TResult>(
        delegate(T) => TResult selector) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (selector == null) {
            throw new System.ArgumentNullException("selector");
        }
        return new SelectEnumerable<T, TResult>(this, selector);
    }

    public SkipEnumerable<T> Skip(uint count) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new SkipEnumerable<T>(this, count);
    }

    public TakeEnumerable<T> Take(uint count) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new TakeEnumerable<T>(this, count);
    }

    public TakeEnumerable<T> Page(uint pageIndex, uint pageSize) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (pageSize == 0u) {
            return new TakeEnumerable<T>(this, 0u);
        }
        if (pageIndex > 4294967295u / pageSize) {
            throw new System.ArgumentOutOfRangeException("pageIndex");
        }
        uint offset = pageIndex * pageSize;
        return new SkipEnumerable<T>(this, offset).Take(pageSize);
    }

    public SortEnumerable<T, TKey> Sort<TKey>(
        delegate(T) => TKey keySelector,
        delegate(TKey, TKey) => int comparer) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (keySelector == null) {
            throw new System.ArgumentNullException("keySelector");
        }
        if (comparer == null) {
            throw new System.ArgumentNullException("comparer");
        }
        return new SortEnumerable<T, TKey>(this, keySelector, comparer, false);
    }

    public SortEnumerable<T, TKey> SortDescending<TKey>(
        delegate(T) => TKey keySelector,
        delegate(TKey, TKey) => int comparer) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (keySelector == null) {
            throw new System.ArgumentNullException("keySelector");
        }
        if (comparer == null) {
            throw new System.ArgumentNullException("comparer");
        }
        return new SortEnumerable<T, TKey>(this, keySelector, comparer, true);
    }

    /// <summary>Returns whether the sequence contains at least one element.</summary>
    public bool Any() const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            return enumerator.MoveNext();
        } finally {
            enumerator.Dispose();
        }
    }

    /// <summary>Returns whether any element satisfies the predicate.</summary>
    public bool Any(delegate(T) => bool predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            while (enumerator.MoveNext()) {
                if (predicate(enumerator.Current)) {
                    return true;
                }
            }
            return false;
        } finally {
            enumerator.Dispose();
        }
    }

    /// <summary>Returns the number of elements, failing if the count exceeds UInt32.</summary>
    public uint Count() const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            uint count = 0u;
            while (enumerator.MoveNext()) {
                if (count == 4294967295u) {
                    throw new System.InvalidOperationException(
                        "Sequence contains more than UInt32.MaxValue elements.");
                }
                count += 1u;
            }
            return count;
        } finally {
            enumerator.Dispose();
        }
    }

    /// <summary>Returns how many elements satisfy the predicate.</summary>
    public uint Count(delegate(T) => bool predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            uint count = 0u;
            while (enumerator.MoveNext()) {
                if (predicate(enumerator.Current)) {
                    if (count == 4294967295u) {
                        throw new System.InvalidOperationException(
                            "Sequence contains more than UInt32.MaxValue matching elements.");
                    }
                    count += 1u;
                }
            }
            return count;
        } finally {
            enumerator.Dispose();
        }
    }

    public T First() const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            if (enumerator.MoveNext()) {
                return enumerator.Current;
            }
            throw new System.InvalidOperationException("Sequence contains no elements.");
        } finally {
            enumerator.Dispose();
        }
    }

    /// <summary>Returns the first element that satisfies the predicate.</summary>
    public T First(delegate(T) => bool predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            while (enumerator.MoveNext()) {
                T value = enumerator.Current;
                if (predicate(value)) {
                    return value;
                }
            }
            throw new System.InvalidOperationException(
                "Sequence contains no matching elements.");
        } finally {
            enumerator.Dispose();
        }
    }

    public T FirstOrDefault() const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            if (enumerator.MoveNext()) {
                return enumerator.Current;
            }
            return default;
        } finally {
            enumerator.Dispose();
        }
    }

    /// <summary>Returns the first matching element, or the default value.</summary>
    public T FirstOrDefault(delegate(T) => bool predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            while (enumerator.MoveNext()) {
                T value = enumerator.Current;
                if (predicate(value)) {
                    return value;
                }
            }
            return default;
        } finally {
            enumerator.Dispose();
        }
    }

    public T Last() const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            bool found = false;
            T result = default;
            while (enumerator.MoveNext()) {
                result = enumerator.Current;
                found = true;
            }
            if (!found) {
                throw new System.InvalidOperationException("Sequence contains no elements.");
            }
            return result;
        } finally {
            enumerator.Dispose();
        }
    }

    /// <summary>Returns the last element that satisfies the predicate.</summary>
    public T Last(delegate(T) => bool predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            bool found = false;
            T result = default;
            while (enumerator.MoveNext()) {
                T value = enumerator.Current;
                if (predicate(value)) {
                    result = value;
                    found = true;
                }
            }
            if (!found) {
                throw new System.InvalidOperationException(
                    "Sequence contains no matching elements.");
            }
            return result;
        } finally {
            enumerator.Dispose();
        }
    }

    public T LastOrDefault() const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            T result = default;
            while (enumerator.MoveNext()) {
                result = enumerator.Current;
            }
            return result;
        } finally {
            enumerator.Dispose();
        }
    }

    /// <summary>Returns the last matching element, or the default value.</summary>
    public T LastOrDefault(delegate(T) => bool predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            T result = default;
            while (enumerator.MoveNext()) {
                T value = enumerator.Current;
                if (predicate(value)) {
                    result = value;
                }
            }
            return result;
        } finally {
            enumerator.Dispose();
        }
    }

    public T Single() const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            if (!enumerator.MoveNext()) {
                throw new System.InvalidOperationException("Sequence contains no elements.");
            }
            T result = enumerator.Current;
            if (enumerator.MoveNext()) {
                throw new System.InvalidOperationException("Sequence contains more than one element.");
            }
            return result;
        } finally {
            enumerator.Dispose();
        }
    }

    /// <summary>Returns the only element that satisfies the predicate.</summary>
    public T Single(delegate(T) => bool predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            bool found = false;
            T result = default;
            while (enumerator.MoveNext()) {
                T value = enumerator.Current;
                if (predicate(value)) {
                    if (found) {
                        throw new System.InvalidOperationException(
                            "Sequence contains more than one matching element.");
                    }
                    result = value;
                    found = true;
                }
            }
            if (!found) {
                throw new System.InvalidOperationException(
                    "Sequence contains no matching elements.");
            }
            return result;
        } finally {
            enumerator.Dispose();
        }
    }

    public T SingleOrDefault() const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            if (!enumerator.MoveNext()) {
                return default;
            }
            T result = enumerator.Current;
            if (enumerator.MoveNext()) {
                throw new System.InvalidOperationException("Sequence contains more than one element.");
            }
            return result;
        } finally {
            enumerator.Dispose();
        }
    }

    /// <summary>Returns the only matching element, or the default value.</summary>
    public T SingleOrDefault(delegate(T) => bool predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            bool found = false;
            T result = default;
            while (enumerator.MoveNext()) {
                T value = enumerator.Current;
                if (predicate(value)) {
                    if (found) {
                        throw new System.InvalidOperationException(
                            "Sequence contains more than one matching element.");
                    }
                    result = value;
                    found = true;
                }
            }
            return result;
        } finally {
            enumerator.Dispose();
        }
    }

    public T ElementAt(uint index) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            uint currentIndex = 0u;
            while (enumerator.MoveNext()) {
                if (currentIndex == index) {
                    return enumerator.Current;
                }
                currentIndex += 1u;
            }
            throw new System.ArgumentOutOfRangeException("index");
        } finally {
            enumerator.Dispose();
        }
    }

    public T ElementAtOrDefault(uint index) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            uint currentIndex = 0u;
            while (enumerator.MoveNext()) {
                if (currentIndex == index) {
                    return enumerator.Current;
                }
                currentIndex += 1u;
            }
            return default;
        } finally {
            enumerator.Dispose();
        }
    }

    public T[] ToArray() const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        List<T> values = new List<T>();
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            while (enumerator.MoveNext()) {
                values.Add(enumerator.Current);
            }
        } finally {
            enumerator.Dispose();
        }
        return values.ToArray();
    }

    public List<T> ToList() const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        List<T> values = new List<T>();
        IEnumerator<T> enumerator = this.GetEnumerator();
        try {
            while (enumerator.MoveNext()) {
                values.Add(enumerator.Current);
            }
        } finally {
            enumerator.Dispose();
        }
        return values;
    }
}

/// <summary>Uses direct indexed reads for skips and pages over concrete arrays.</summary>
public extension ArrayQueryExtensions<T> : Array<T> {
    public ArrayMapEnumerable<T, TResult> Map<TResult>(
        delegate(T) => TResult selector) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (selector == null) {
            throw new System.ArgumentNullException("selector");
        }
        return new ArrayMapEnumerable<T, TResult>(this, selector);
    }

    public ArrayWhereEnumerable<T> Filter(
        delegate(T) => bool predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new ArrayWhereEnumerable<T>(this, predicate);
    }

    public ArraySkipEnumerable<T> Skip(uint count) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new ArraySkipEnumerable<T>(this, count);
    }

    public ArrayPageEnumerable<T> Page(uint pageIndex, uint pageSize) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (pageSize != 0u && pageIndex > 4294967295u / pageSize) {
            throw new System.ArgumentOutOfRangeException("pageIndex");
        }
        uint offset = 0u;
        if (pageSize != 0u) { offset = pageIndex * pageSize; }
        return new ArrayPageEnumerable<T>(this, offset, pageSize);
    }

}

/// <summary>A deferred filter that scans concrete array storage by index.</summary>
public final class ArrayWhereEnumerable<T> : IEnumerable<T> {
    internal Array<T> _source;
    internal delegate(T) => bool _predicate;

    internal constructor(Array<T> source, delegate(T) => bool predicate) {
        _source = source;
        _predicate = predicate;
    }

    public IEnumerator<T> GetEnumerator() const {
        return new ArrayWhereEnumerator<T>(
            _source, _predicate, _source.Length);
    }

    public ArrayWhereTakeEnumerable<T> Take(uint count) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new ArrayWhereTakeEnumerable<T>(this, count);
    }

    public ArrayWhereSkipEnumerable<T> Skip(uint count) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new ArrayWhereSkipEnumerable<T>(this, count);
    }
}

/// <summary>Fuses indexed array filtering with a bounded output prefix.</summary>
public final class ArrayWhereTakeEnumerable<T> : IEnumerable<T> {
    private ArrayWhereEnumerable<T> _source;
    private uint _count;

    internal constructor(ArrayWhereEnumerable<T> source, uint count) {
        _source = source;
        _count = count;
    }

    public IEnumerator<T> GetEnumerator() const {
        return new IndexedWhereTakeEnumerator<T>(
            _source._source, _source._predicate,
            _source._source.Length, 0u, _count);
    }
}

public final class ArrayWhereSkipEnumerable<T> : IEnumerable<T> {
