        _length = length;
        _remaining = count;
    }

    public bool MoveNext() {
        if (_disposed) {
            Dispose();
            return false;
        }
        if (_remaining == 0u) {
            Dispose();
            return false;
        }
        try {
            while (_index < _length) {
                T value = _source.Get(_index);
                _index += 1u;
                if (!_predicate(value)) { continue; }
                TResult projected = _selector(value);
                _current = projected;
                _remaining -= 1u;
                if (_remaining == 0u) { ReleaseSource(); }
                return true;
            }
        } catch (System.Exception) {
            Dispose();
            throw;
        }
        Dispose();
        return false;
    }

    private void ReleaseSource() {
        if (!_disposed) {
            _disposed = true;
            _source = null;
            _predicate = default;
            _selector = default;
        }
    }

    public void Dispose() {
        ReleaseSource();
        _current = default;
    }
}

