/// <summary>Fuses indexed array mapping with a bounded output prefix.</summary>
public final class ArrayMapTakeEnumerable<T, TResult> : IEnumerable<TResult> {
    private ArrayMapEnumerable<T, TResult> _source;
    private uint _count;

    internal constructor(ArrayMapEnumerable<T, TResult> source, uint count) {
        _source = source;
        _count = count;
    }

    public IEnumerator<TResult> GetEnumerator() const {
        return new IndexedMapTakeEnumerator<T, TResult>(
            _source._source, _source._selector,
            _source._source.Length, _count);
    }
}

public final class IndexedMapTakeEnumerator<T, TResult>
    : IEnumerator<TResult> {
    private Array<T> _source;
    private delegate(T) => TResult _selector;
    private uint _index;
    private uint _length;
    private uint _remaining;
    private TResult _current;
    private bool _disposed;

    public TResult Current { const get { return _current; } }

    internal constructor(
        Array<T> source,
        delegate(T) => TResult selector,
        uint length,
        uint count) {
        _source = source;
        _selector = selector;
        _length = length;
        _remaining = count;
    }

    public bool MoveNext() {
        if (_disposed || _remaining == 0u || _index >= _length) {
            Dispose();
            return false;
        }
        try {
            T value = _source.Get(_index);
            _index += 1u;
            _current = _selector(value);
            _remaining -= 1u;
            if (_remaining == 0u) { ReleaseSource(); }
            return true;
        } catch (System.Exception) {
            Dispose();
            throw;
        }
    }

    private void ReleaseSource() {
        if (!_disposed) {
            _disposed = true;
            _source = null;
            _selector = default;
        }
    }

    public void Dispose() {
        ReleaseSource();
        _current = default;
    }
}

/// <summary>Fuses indexed mapping with a skipped prefix and bounded output.</summary>
