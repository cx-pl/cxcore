    private List<TFourthKey> _fourthKeys;
    private uint _index;
    private T _current;
    private bool _started;
    private bool _disposed;

    public T Current { const get { return _current; } }

    internal constructor(
        IEnumerable<T> source,
        delegate(T) => TKey keySelector,
        delegate(TKey, TKey) => int comparer,
        bool descending,
        delegate(T) => TNextKey nextKeySelector,
        delegate(TNextKey, TNextKey) => int nextComparer,
        bool nextDescending,
        delegate(T) => TThirdKey thirdKeySelector,
        delegate(TThirdKey, TThirdKey) => int thirdComparer,
        bool thirdDescending,
        delegate(T) => TFourthKey fourthKeySelector,
        delegate(TFourthKey, TFourthKey) => int fourthComparer,
        bool fourthDescending) {
        _source = source;
        _keySelector = keySelector;
        _comparer = comparer;
        _descending = descending;
        _nextKeySelector = nextKeySelector;
        _nextComparer = nextComparer;
        _nextDescending = nextDescending;
        _thirdKeySelector = thirdKeySelector;
        _thirdComparer = thirdComparer;
        _thirdDescending = thirdDescending;
        _fourthKeySelector = fourthKeySelector;
        _fourthComparer = fourthComparer;
        _fourthDescending = fourthDescending;
        _items = new List<T>();
        _keys = new List<TKey>();
        _nextKeys = new List<TNextKey>();
        _thirdKeys = new List<TThirdKey>();
        _fourthKeys = new List<TFourthKey>();
        _index = 0u;
        _started = false;
        _disposed = false;
    }

    public bool MoveNext() {
        if (_disposed) {
            return false;
        }
        if (!_started) {
            _started = true;
            try {
                LoadAndSort();
            } catch (System.Exception) {
                Dispose();
                throw;
            }
        }
        if (_index >= _items.Count) {
            Dispose();
            return false;
        }
        _current = _items.Get(_index);
        _index += 1u;
        return true;
    }

    private void LoadAndSort() {
        Array<T> arraySource = _source as Array<T>;
        List<T> listSource = _source as List<T>;
        ArrayEnumerator<T> indexedEnumerator = default;
        if (arraySource != null) {
            indexedEnumerator = arraySource.GetEnumerator(arraySource.Length);
        } else if (listSource != null) {
            Array<T> listStorage = listSource.GetQueryStorage();
            indexedEnumerator = listStorage.GetEnumerator(listSource.Count);
        }
        if (indexedEnumerator != null) {
            try {
                while (indexedEnumerator.MoveNext()) {
                    T item = indexedEnumerator.Current;
                    TKey key = _keySelector(item);
                    TNextKey nextKey = _nextKeySelector(item);
                    TThirdKey thirdKey = _thirdKeySelector(item);
                    TFourthKey fourthKey = _fourthKeySelector(item);
                    _items.Add(item);
                    _keys.Add(key);
                    _nextKeys.Add(nextKey);
                    _thirdKeys.Add(thirdKey);
                    _fourthKeys.Add(fourthKey);
                }
            } finally {
                indexedEnumerator.Dispose();
            }
        } else {
            IEnumerator<T> enumerator = _source.GetEnumerator();
            try {
                while (enumerator.MoveNext()) {
                    T item = enumerator.Current;
                    TKey key = _keySelector(item);
                    TNextKey nextKey = _nextKeySelector(item);
                    TThirdKey thirdKey = _thirdKeySelector(item);
                    TFourthKey fourthKey = _fourthKeySelector(item);
                    _items.Add(item);
                    _keys.Add(key);
                    _nextKeys.Add(nextKey);
                    _thirdKeys.Add(thirdKey);
                    _fourthKeys.Add(fourthKey);
                }
            } finally {
                enumerator.Dispose();
            }
        }
        SortBufferedItems();
    }

    private void SortBufferedItems() {
        uint count = _items.Count;
        if (count < 2u) {
            return;
        }
        List<T> scratchItems = new List<T>();
        List<TKey> scratchKeys = new List<TKey>();
        List<TNextKey> scratchNextKeys = new List<TNextKey>();
        List<TThirdKey> scratchThirdKeys = new List<TThirdKey>();
        List<TFourthKey> scratchFourthKeys = new List<TFourthKey>();
        T emptyItem = default;
        TKey emptyKey = default;
        TNextKey emptyNextKey = default;
        TThirdKey emptyThirdKey = default;
        TFourthKey emptyFourthKey = default;
        for (uint index = 0u; index < count; index += 1u) {
            scratchItems.Add(emptyItem);
            scratchKeys.Add(emptyKey);
            scratchNextKeys.Add(emptyNextKey);
            scratchThirdKeys.Add(emptyThirdKey);
            scratchFourthKeys.Add(emptyFourthKey);
        }
        uint width = 1u;
        while (width < count) {
            uint start = 0u;
            while (start < count) {
                uint mid = width > count - start ? count : start + width;
                uint remaining = count - mid;
                uint end = width > remaining ? count : mid + width;
                uint left = start;
                uint right = mid;
                uint destination = start;
                while (left < mid && right < end) {
                    int comparison = _comparer(_keys.Get(left), _keys.Get(right));
                    bool takeLeft = (!_descending && comparison <= 0) ||
                        (_descending && comparison >= 0);
                    if (comparison == 0) {
                        comparison = _nextComparer(
                            _nextKeys.Get(left), _nextKeys.Get(right));
                        takeLeft = (!_nextDescending && comparison <= 0) ||
                            (_nextDescending && comparison >= 0);
                        if (comparison == 0) {
                            comparison = _thirdComparer(
                                _thirdKeys.Get(left), _thirdKeys.Get(right));
                            takeLeft = (!_thirdDescending && comparison <= 0) ||
                                (_thirdDescending && comparison >= 0);
                            if (comparison == 0) {
                                comparison = _fourthComparer(
                                    _fourthKeys.Get(left), _fourthKeys.Get(right));
                                takeLeft = (!_fourthDescending && comparison <= 0) ||
                                    (_fourthDescending && comparison >= 0);
                            }
                        }
                    }
                    if (takeLeft) {
                        scratchItems.Set(destination, _items.Get(left));
                        scratchKeys.Set(destination, _keys.Get(left));
                        scratchNextKeys.Set(destination, _nextKeys.Get(left));
                        scratchThirdKeys.Set(destination, _thirdKeys.Get(left));
                        scratchFourthKeys.Set(destination, _fourthKeys.Get(left));
                        left += 1u;
                    } else {
                        scratchItems.Set(destination, _items.Get(right));
                        scratchKeys.Set(destination, _keys.Get(right));
                        scratchNextKeys.Set(destination, _nextKeys.Get(right));
                        scratchThirdKeys.Set(destination, _thirdKeys.Get(right));
                        scratchFourthKeys.Set(destination, _fourthKeys.Get(right));
                        right += 1u;
                    }
                    destination += 1u;
                }
                while (left < mid) {
                    scratchItems.Set(destination, _items.Get(left));
                    scratchKeys.Set(destination, _keys.Get(left));
                    scratchNextKeys.Set(destination, _nextKeys.Get(left));
                    scratchThirdKeys.Set(destination, _thirdKeys.Get(left));
                    scratchFourthKeys.Set(destination, _fourthKeys.Get(left));
                    left += 1u;
                    destination += 1u;
                }
                while (right < end) {
                    scratchItems.Set(destination, _items.Get(right));
                    scratchKeys.Set(destination, _keys.Get(right));
                    scratchNextKeys.Set(destination, _nextKeys.Get(right));
                    scratchThirdKeys.Set(destination, _thirdKeys.Get(right));
                    scratchFourthKeys.Set(destination, _fourthKeys.Get(right));
                    right += 1u;
                    destination += 1u;
                }
                start = end;
            }
            List<T> previousItems = _items;
            List<TKey> previousKeys = _keys;
            List<TNextKey> previousNextKeys = _nextKeys;
            List<TThirdKey> previousThirdKeys = _thirdKeys;
            List<TFourthKey> previousFourthKeys = _fourthKeys;
            _items = scratchItems;
            _keys = scratchKeys;
            _nextKeys = scratchNextKeys;
            _thirdKeys = scratchThirdKeys;
            _fourthKeys = scratchFourthKeys;
            scratchItems = previousItems;
            scratchKeys = previousKeys;
            scratchNextKeys = previousNextKeys;
            scratchThirdKeys = previousThirdKeys;
            scratchFourthKeys = previousFourthKeys;
            if (width > count - width) {
                width = count;
            } else {
                width += width;
            }
        }
    }

    public void Dispose() {
        if (!_disposed) {
            _disposed = true;
            _source = default;
            _keySelector = default;
            _comparer = default;
            _nextKeySelector = default;
            _nextComparer = default;
            _thirdKeySelector = default;
            _thirdComparer = default;
            _fourthKeySelector = default;
            _fourthComparer = default;
            _items = default;
            _keys = default;
            _nextKeys = default;
            _thirdKeys = default;
            _fourthKeys = default;
            _current = default;
        }
    }
}

