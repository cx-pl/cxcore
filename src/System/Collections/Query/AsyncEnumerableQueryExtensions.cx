        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return this.FilterAsync(predicate).SingleOrDefaultAsync(
            cancellationToken);
    }


    /// <summary>Returns the asynchronous element at the requested zero-based index.</summary>
    public Task<T> ElementAtAsync(
        uint index,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "ElementAt", index, false, null, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the asynchronous element at the index or the default value.</summary>
    public Task<T> ElementAtOrDefaultAsync(
        uint index,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "ElementAt", index, true, null, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Materializes this asynchronous sequence as a list.</summary>
    public Task<List<T>> ToListAsync(
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncListMaterializer<T, uint>(
            this,
            cancellationToken,
            null,
            new List<T>(),
            new Task<List<T>>()).Start();
    }

    /// <summary>Materializes this asynchronous sequence as an array.</summary>
    public Task<T[]> ToArrayAsync(
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        Task<List<T>> listTask = ToListAsync(cancellationToken);
        return new AsyncArrayMaterializer<T, uint>(
            listTask, new Task<T[]>()).Start();
    }
}

internal final class AsyncAnyOperation<T, TLayout> {
    private IAsyncEnumerable<T> _source;
    private delegate(T) => bool _predicate;
    private CancellationToken _cancellationToken;
    private IAsyncEnumerator<T> _enumerator;
    private Task<bool> _completion;
    private bool _isDisposing;

    internal constructor() { }

    internal constructor(
        IAsyncEnumerable<T> source,
        delegate(T) => bool predicate,
        CancellationToken cancellationToken,
        IAsyncEnumerator<T> enumerator,
        Task<bool> completion) {
        _source = source;
        _predicate = predicate;
        _cancellationToken = cancellationToken;
        _enumerator = enumerator;
        _completion = completion;
    }

    internal Task<bool> Start() {
        try {
            _enumerator = _source.GetAsyncEnumerator(_cancellationToken);
            if (_enumerator == null) {
                Complete(new System.InvalidOperationException(
                    "The async source returned a null enumerator."), false);
                return _completion;
            }
        } catch (System.Exception exception) {
            Complete(exception, false);
            return _completion;
        }
        Advance();
        return _completion;
    }

    private void Advance() {
        while (true) {
            Task<bool> moveTask;
            try {
                moveTask = _enumerator.MoveNextAsync().AsTask();
            } catch (System.Exception exception) {
                BeginDispose(exception, false);
                return;
            }
            if (!moveTask.IsCompleted) {
                AsyncAnyOperation<T, TLayout> state = this;
                moveTask.OnCompleted(() => state.CompleteMove(moveTask));
                return;
            }
            bool moved;
            try {
                moved = moveTask.GetResult();
            } catch (System.Exception exception) {
                BeginDispose(exception, false);
                return;
            }
            if (!moved) {
                BeginDispose(null, false);
                return;
            }
            bool matches;
            try {
                matches = _predicate == null ||
                    _predicate(_enumerator.Current);
            } catch (System.Exception exception) {
                BeginDispose(exception, false);
                return;
            }
            if (matches) {
                BeginDispose(null, true);
                return;
            }
        }
    }

    private void CompleteMove(Task<bool> moveTask) {
        bool moved;
        try {
            moved = moveTask.GetResult();
        } catch (System.Exception exception) {
            BeginDispose(exception, false);
            return;
        }
        if (!moved) {
            BeginDispose(null, false);
            return;
        }
        bool matches;
        try {
            matches = _predicate == null ||
                _predicate(_enumerator.Current);
        } catch (System.Exception exception) {
            BeginDispose(exception, false);
            return;
        }
        if (matches) {
            BeginDispose(null, true);
        } else {
            Advance();
        }
    }

    private void BeginDispose(
        System.Exception failure,
        bool found) {
        if (_isDisposing) { return; }
        _isDisposing = true;
        TaskHandle disposeTask;
        try {
            disposeTask = _enumerator.DisposeAsync().AsTask();
        } catch (System.Exception exception) {
            Complete(exception, false);
            return;
        }
        if (disposeTask.IsCompleted) {
            CompleteDispose(disposeTask, failure, found);
        } else {
            AsyncAnyOperation<T, TLayout> state = this;
            disposeTask.OnCompleted(() =>
                state.CompleteDispose(disposeTask, failure, found));
        }
    }

    private void CompleteDispose(
        TaskHandle disposeTask,
        System.Exception failure,
        bool found) {
        try {
            disposeTask.GetResult();
        } catch (System.Exception disposeException) {
            failure = disposeException;
        }
        Complete(failure, found);
    }

    private void Complete(
        System.Exception failure,
        bool found) {
        if (failure is OperationCanceledException) {
            _completion.SetCanceled();
        } else if (failure != null) {
            _completion.SetFault(failure);
        } else {
            _completion.SetResult(found);
        }
        _source = default;
        _predicate = default;
        _cancellationToken = default;
        _enumerator = default;
    }
}

internal final class AsyncCountOperation<T, TLayout> {
    private IAsyncEnumerable<T> _source;
    private delegate(T) => bool _predicate;
    private CancellationToken _cancellationToken;
    private IAsyncEnumerator<T> _enumerator;
    private uint _count;
    private Task<uint> _completion;
    private bool _isDisposing;

    internal constructor() { }

    internal constructor(
        IAsyncEnumerable<T> source,
        delegate(T) => bool predicate,
        CancellationToken cancellationToken,
        IAsyncEnumerator<T> enumerator,
        uint count,
        Task<uint> completion) {
        _source = source;
        _predicate = predicate;
        _cancellationToken = cancellationToken;
        _enumerator = enumerator;
        _count = count;
        _completion = completion;
    }

    internal Task<uint> Start() {
        try {
            _enumerator = _source.GetAsyncEnumerator(_cancellationToken);
            if (_enumerator == null) {
                Complete(new System.InvalidOperationException(
                    "The async source returned a null enumerator."));
                return _completion;
            }
        } catch (System.Exception exception) {
            Complete(exception);
            return _completion;
        }
        Advance();
        return _completion;
    }

    private void Advance() {
        while (true) {
            Task<bool> moveTask;
            try {
                moveTask = _enumerator.MoveNextAsync().AsTask();
            } catch (System.Exception exception) {
                BeginDispose(exception);
                return;
            }
            if (!moveTask.IsCompleted) {
                AsyncCountOperation<T, TLayout> state = this;
                moveTask.OnCompleted(() => state.CompleteMove(moveTask));
                return;
            }
            bool moved;
            try {
                moved = moveTask.GetResult();
            } catch (System.Exception exception) {
                BeginDispose(exception);
                return;
            }
            if (!moved) {
                BeginDispose(null);
                return;
            }
            CountCurrent();
            if (_isDisposing) { return; }
        }
    }

    private void CompleteMove(Task<bool> moveTask) {
        bool moved;
        try {
            moved = moveTask.GetResult();
        } catch (System.Exception exception) {
            BeginDispose(exception);
            return;
        }
        if (!moved) {
            BeginDispose(null);
            return;
        }
        CountCurrent();
        if (!_isDisposing) { Advance(); }
    }

    private void CountCurrent() {
        bool matches;
        try {
            matches = _predicate == null ||
                _predicate(_enumerator.Current);
        } catch (System.Exception exception) {
            BeginDispose(exception);
            return;
        }
        if (!matches) { return; }
        if (_count == 4294967295u) {
            if (_predicate == null) {
                BeginDispose(new System.InvalidOperationException(
                    "Sequence contains more than UInt32.MaxValue elements."));
            } else {
                BeginDispose(new System.InvalidOperationException(
                    "Sequence contains more than UInt32.MaxValue matching elements."));
            }
            return;
        }
        _count += 1u;
    }

    private void BeginDispose(System.Exception failure) {
        if (_isDisposing) { return; }
        _isDisposing = true;
        TaskHandle disposeTask;
        try {
            disposeTask = _enumerator.DisposeAsync().AsTask();
        } catch (System.Exception exception) {
            Complete(exception);
            return;
        }
        if (disposeTask.IsCompleted) {
            CompleteDispose(disposeTask, failure);
        } else {
            AsyncCountOperation<T, TLayout> state = this;
            disposeTask.OnCompleted(() =>
                state.CompleteDispose(disposeTask, failure));
        }
    }

    private void CompleteDispose(
        TaskHandle disposeTask,
        System.Exception failure) {
        try {
            disposeTask.GetResult();
        } catch (System.Exception disposeException) {
            failure = disposeException;
        }
        Complete(failure);
    }

    private void Complete(System.Exception failure) {
        if (failure is OperationCanceledException) {
            _completion.SetCanceled();
        } else if (failure != null) {
            _completion.SetFault(failure);
        } else {
            _completion.SetResult(_count);
        }
        _source = default;
        _predicate = default;
        _cancellationToken = default;
        _enumerator = default;
    }
}

internal final class AsyncPositionOperation<T, TLayout> {
    private IAsyncEnumerable<T> _source;
    private string _kind;
    private uint _index;
    private bool _orDefault;
    private delegate(T) => bool _predicate;
    private CancellationToken _cancellationToken;
    private IAsyncEnumerator<T> _enumerator;
    private bool _hasValue;
    private T _value;
    private bool _isDisposing;
    private Task<T> _completion;

    internal constructor() { }

    internal constructor(
        IAsyncEnumerable<T> source,
        string kind,
        uint index,
        bool orDefault,
        delegate(T) => bool predicate,
        CancellationToken cancellationToken,
        IAsyncEnumerator<T> enumerator,
        bool hasValue,
        Task<T> completion) {
        _source = source;
        _kind = kind;
        _index = index;
        _orDefault = orDefault;
        _predicate = predicate;
        _cancellationToken = cancellationToken;
        _enumerator = enumerator;
        _hasValue = hasValue;
        _completion = completion;
    }

    internal Task<T> Start() {
        try {
            _enumerator = _source.GetAsyncEnumerator(_cancellationToken);
            if (_enumerator == null) {
                Complete(new System.InvalidOperationException(
                    "The async source returned a null enumerator."));
                return _completion;
            }
        } catch (System.Exception exception) {
            Complete(exception);
            return _completion;
        }
        Advance();
        return _completion;
    }

    private void Advance() {
        while (true) {
            Task<bool> moveTask;
            try {
                moveTask = _enumerator.MoveNextAsync().AsTask();
            } catch (System.Exception exception) {
                BeginDispose(exception);
                return;
            }
            if (!moveTask.IsCompleted) {
                AsyncPositionOperation<T, TLayout> state = this;
                moveTask.OnCompleted(() => state.CompleteMove(moveTask));
                return;
            }
            bool moved;
            try {
                moved = moveTask.GetResult();
            } catch (System.Exception exception) {
                BeginDispose(exception);
                return;
            }
            if (!moved) {
                FinishAtEnd();
                return;
            }
            if (ProcessCurrent()) { return; }
        }
    }

    private void CompleteMove(Task<bool> moveTask) {
        bool moved;
        try {
            moved = moveTask.GetResult();
        } catch (System.Exception exception) {
            BeginDispose(exception);
            return;
        }
        if (!moved) {
            FinishAtEnd();
            return;
        }
        if (!ProcessCurrent()) { Advance(); }
    }

    private bool ProcessCurrent() {
        T current;
        try {
            current = _enumerator.Current;
        } catch (System.Exception exception) {
            BeginDispose(exception);
            return true;
        }
        if (_predicate != null) {
            bool matches;
            try {
                matches = _predicate(current);
            } catch (System.Exception exception) {
                BeginDispose(exception);
                return true;
            }
            if (!matches) { return false; }
        }
        return ProcessValue(current);
    }

    private bool ProcessValue(T current) {
        if (_kind == "First") {
            _value = current;
            _hasValue = true;
            BeginDispose(null);
            return true;
        }
        if (_kind == "ElementAt") {
            if (_index == 0u) {
                _value = current;
                _hasValue = true;
                BeginDispose(null);
                return true;
            }
            _index -= 1u;
            return false;
        }
        if (_kind == "Last") {
            _value = current;
            _hasValue = true;
            return false;
        }
        if (!_hasValue) {
            _value = current;
            _hasValue = true;
            return false;
        }
        BeginDispose(new System.InvalidOperationException(
            "Sequence contains more than one element."));
        return true;
    }

    private void FinishAtEnd() {
        if (_hasValue) {
            BeginDispose(null);
        } else if (_orDefault) {
            BeginDispose(null);
        } else if (_kind == "ElementAt") {
            BeginDispose(new System.ArgumentOutOfRangeException("index"));
        } else {
            BeginDispose(new System.InvalidOperationException(
                "Sequence contains no elements."));
        }
    }

    private void BeginDispose(System.Exception failure) {
        if (_isDisposing) { return; }
        _isDisposing = true;
        TaskHandle disposeTask;
        try {
            disposeTask = _enumerator.DisposeAsync().AsTask();
        } catch (System.Exception exception) {
            Complete(exception);
            return;
        }
        if (disposeTask.IsCompleted) {
            CompleteDispose(disposeTask, failure);
        } else {
            AsyncPositionOperation<T, TLayout> state = this;
            disposeTask.OnCompleted(() =>
                state.CompleteDispose(disposeTask, failure));
        }
    }

    private void CompleteDispose(
        TaskHandle disposeTask,
        System.Exception failure) {
        try {
            disposeTask.GetResult();
        } catch (System.Exception disposeException) {
            failure = disposeException;
        }
        Complete(failure);
    }

    private void Complete(System.Exception failure) {
        if (failure is OperationCanceledException) {
            _completion.SetCanceled();
        } else if (failure != null) {
            _completion.SetFault(failure);
        } else {
            _completion.SetResult(_value);
        }
        _source = default;
        _kind = default;
        _predicate = null;
        _cancellationToken = default;
        _enumerator = default;
        _value = default;
    }
}

// The value-type layout marker keeps per-T fields concrete when T is a class.
internal final class AsyncArrayMaterializer<T, TLayout> {
    private Task<List<T>> _listTask;
    private Task<T[]> _completion;

    internal constructor() {
    }

    internal constructor(
        Task<List<T>> listTask,
        Task<T[]> completion) {
        _listTask = listTask;
        _completion = completion;
    }

    internal Task<T[]> Start() {
        if (_listTask.IsCompleted) {
            Complete();
        } else {
            AsyncArrayMaterializer<T, TLayout> state = this;
            _listTask.OnCompleted(() => state.Complete());
        }
        return _completion;
    }

    private void Complete() {
        try {
            _completion.SetResult(_listTask.GetResult().ToArray());
        } catch (OperationCanceledException) {
            _completion.SetCanceled();
        } catch (System.Exception exception) {
            _completion.SetFault(exception);
        }
        _listTask = default;
    }
}

internal final class AsyncListMaterializer<T, TLayout> {
    private IAsyncEnumerable<T> _source;
    private CancellationToken _cancellationToken;
    private IAsyncEnumerator<T> _enumerator;
    private List<T> _values;
    private Task<List<T>> _completion;

    internal constructor() {
    }

    internal constructor(
        IAsyncEnumerable<T> source,
        CancellationToken cancellationToken,
        IAsyncEnumerator<T> enumerator,
        List<T> values,
        Task<List<T>> completion) {
        _source = source;
        _cancellationToken = cancellationToken;
        _enumerator = enumerator;
        _values = values;
        _completion = completion;
    }

    internal Task<List<T>> Start() {
        try {
            _enumerator = _source.GetAsyncEnumerator(_cancellationToken);
            if (_enumerator == null) {
                Complete(new System.InvalidOperationException(
                    "The async source returned a null enumerator."));
                return _completion;
            }
        } catch (System.Exception exception) {
            Complete(exception);
            return _completion;
        }
        Advance();
        return _completion;
    }

    private void Advance() {
        while (true) {
            Task<bool> moveTask;
            try {
                moveTask = _enumerator.MoveNextAsync().AsTask();
            } catch (System.Exception exception) {
                BeginDispose(exception);
                return;
            }
            if (!moveTask.IsCompleted) {
                AsyncListMaterializer<T, TLayout> state = this;
                moveTask.OnCompleted(() => state.CompleteMove(moveTask));
                return;
            }
            bool moved;
            try {
                moved = moveTask.GetResult();
            } catch (System.Exception exception) {
                BeginDispose(exception);
                return;
            }
            if (!moved) {
                BeginDispose(null);
                return;
            }
            try {
                _values.Add(_enumerator.Current);
            } catch (System.Exception exception) {
                BeginDispose(exception);
                return;
            }
        }
    }

    private void CompleteMove(Task<bool> moveTask) {
        bool moved;
        try {
            moved = moveTask.GetResult();
        } catch (System.Exception exception) {
            BeginDispose(exception);
            return;
        }
        if (!moved) {
            BeginDispose(null);
            return;
        }
        try {
            _values.Add(_enumerator.Current);
        } catch (System.Exception exception) {
            BeginDispose(exception);
            return;
        }
        Advance();
    }

    private void BeginDispose(System.Exception failure) {
        TaskHandle disposeTask;
        try {
            disposeTask = _enumerator.DisposeAsync().AsTask();
        } catch (System.Exception exception) {
            Complete(exception);
            return;
        }
        if (disposeTask.IsCompleted) {
            CompleteDispose(disposeTask, failure);
        } else {
            AsyncListMaterializer<T, TLayout> state = this;
            disposeTask.OnCompleted(() =>
                state.CompleteDispose(disposeTask, failure));
        }
    }

    private void CompleteDispose(
        TaskHandle disposeTask,
        System.Exception failure) {
        try {
            disposeTask.GetResult();
        } catch (System.Exception disposeException) {
            failure = disposeException;
        }
        Complete(failure);
    }

    private void Complete(System.Exception failure) {
        if (failure is OperationCanceledException) {
            _completion.SetCanceled();
        } else if (failure != null) {
            _completion.SetFault(failure);
        } else {
            _completion.SetResult(_values);
        }
        _source = default;
        _cancellationToken = default;
        _enumerator = default;
        _values = default;
    }
}

/// <summary>A replayable asynchronous projection.</summary>
public final class AsyncSelectEnumerable<T, TResult> : IAsyncEnumerable<TResult> {
    private IAsyncEnumerable<T> _source;
    private delegate(T) => TResult _selector;

    internal constructor(
        IAsyncEnumerable<T> source,
        delegate(T) => TResult selector) {
        _source = source;
        _selector = selector;
    }

    public IAsyncEnumerator<TResult> GetAsyncEnumerator(
        CancellationToken cancellationToken) {
        return new AsyncSelectEnumerator<T, TResult>(
            _source, _selector, cancellationToken);
    }
}

public final class AsyncSelectEnumerator<T, TResult> : IAsyncEnumerator<TResult> {
    private IAsyncEnumerable<T> _source;
    private IAsyncEnumerator<T> _sourceEnumerator;
    private delegate(T) => TResult _selector;
    private TResult _current;
    private CancellationToken _cancellationToken;
    private TaskHandle _disposeTask;
    private TaskCompletionSource _disposeCompletion;
    private Task<bool> _pendingMove;
    private bool _sourceOpened;
    private bool _hasCurrent;
    private bool _disposed;
    private bool _disposeStarted;

    public TResult Current {
        const get {
            if (!_hasCurrent) {
                _current = _selector(_sourceEnumerator.Current);
                _hasCurrent = true;
            }
            return _current;
        }
    }

    internal constructor(
        IAsyncEnumerable<T> source,
        delegate(T) => TResult selector,
        CancellationToken cancellationToken) {
        _source = source;
        _sourceEnumerator = null;
        _selector = selector;
        _cancellationToken = cancellationToken;
        _disposeTask = null;
        _disposeCompletion = null;
        _pendingMove = null;
        _sourceOpened = false;
        _hasCurrent = false;
        _disposed = false;
        _disposeStarted = false;
    }

    public ValueTask<bool> MoveNextAsync() {
        if (_disposed) {
            return new ValueTask<bool>(false);
        }
        if (_pendingMove != null && !_pendingMove.IsCompleted) {
            throw new System.InvalidOperationException(
                "A Map MoveNextAsync operation is already pending.");
        }
        _hasCurrent = false;
        _current = default;
        if (!_sourceOpened) {
            _sourceOpened = true;
            _sourceEnumerator = _source.GetAsyncEnumerator(
                _cancellationToken);
            if (_sourceEnumerator == null) {
                _sourceOpened = false;
                throw new System.InvalidOperationException(
                    "The async source returned a null enumerator.");
            }
        }
        ValueTask<bool> sourceMove = _sourceEnumerator.MoveNextAsync();
        Task<bool> sourceTask = sourceMove.AsTask();
        if (sourceTask.IsCompleted) {
            ValueTask<bool> completedMove;
            completedMove.SetTask(sourceTask);
            return completedMove;
        }
        TaskCompletionSource<bool> completion =
            new TaskCompletionSource<bool>();
        _pendingMove = completion.GetTask();
        AsyncSelectEnumerator<T, TResult> state = this;
        sourceTask.OnCompleted(() =>
            state.CompleteMove(sourceTask, completion));
        ValueTask<bool> result;
        result.SetTask(_pendingMove);
        return result;
    }

    private void CompleteMove(
        Task<bool> sourceMove,
        TaskCompletionSource<bool> completion) {
        try {
            bool moved = sourceMove.GetResult();
            completion.SetResult(moved && !_disposed);
        } catch (OperationCanceledException) {
            completion.SetCanceled();
        } catch (System.Exception exception) {
            completion.SetException(exception);
        }
    }

    private void DisposeAfterPendingMove() {
        try {
            _pendingMove.GetResult();
        } catch (System.Exception) {
            // The move operation reports its own failure to its caller.
        }
        _pendingMove = default;
        TaskHandle upstreamDispose;
        try {
            upstreamDispose = _sourceEnumerator.DisposeAsync().AsTask();
            _sourceEnumerator = default;
        } catch (System.Exception exception) {
            _sourceEnumerator = default;
            _disposeCompletion.SetException(exception);
            return;
        }
        if (upstreamDispose.IsCompleted) {
            CompletePendingDispose(upstreamDispose);
        } else {
            AsyncSelectEnumerator<T, TResult> state = this;
            upstreamDispose.OnCompleted(() =>
                state.CompletePendingDispose(upstreamDispose));
        }
    }

    private void CompletePendingDispose(TaskHandle upstreamDispose) {
        try {
            upstreamDispose.GetResult();
            _disposeCompletion.SetResult();
        } catch (OperationCanceledException) {
            _disposeCompletion.SetCanceled();
        } catch (System.Exception exception) {
            _disposeCompletion.SetException(exception);
        }
    }

    public ValueTask DisposeAsync() {
        if (_disposeStarted) {
            return new ValueTask(_disposeTask);
        }
        _disposeStarted = true;
        _disposed = true;
        _source = default;
        _selector = default;
        _current = default;
        _hasCurrent = false;
        if (_pendingMove != null && !_pendingMove.IsCompleted) {
            _disposeCompletion = new TaskCompletionSource();
            _disposeTask = _disposeCompletion.Task;
            AsyncSelectEnumerator<T, TResult> state = this;
            _pendingMove.OnCompleted(() => state.DisposeAfterPendingMove());
            return new ValueTask(_disposeTask);
        }
        if (_sourceOpened) {
            ValueTask disposeValueTask = _sourceEnumerator.DisposeAsync();
            _sourceEnumerator = default;
            _disposeTask = disposeValueTask.AsTask();
        } else {
            _disposeTask = new TaskHandle();
        }
        return new ValueTask(_disposeTask);
    }
}

/// <summary>A replayable asynchronous projection with an awaited selector.</summary>
public final class AsyncMapAsyncEnumerable<T, TResult> : IAsyncEnumerable<TResult> {
    private IAsyncEnumerable<T> _source;
    private delegate(T) => Task<TResult> _selector;

    internal constructor(
        IAsyncEnumerable<T> source,
        delegate(T) => Task<TResult> selector) {
        _source = source;
        _selector = selector;
    }

    public IAsyncEnumerator<TResult> GetAsyncEnumerator(
        CancellationToken cancellationToken) {
        return new AsyncMapAsyncEnumerator<T, TResult>(
            _source, _selector, cancellationToken);
