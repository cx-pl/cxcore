import System.Collections;
import System.Threading.Tasks;

namespace System.Collections.Query;
/// <summary>Deferred, pull-based query operators for async sequences.</summary>
public extension AsyncEnumerableQueryExtensions<T> : IAsyncEnumerable<T> {
    public AsyncSelectEnumerable<T, TResult> Map<TResult>(
        delegate(T) => TResult selector) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (selector == null) {
            throw new System.ArgumentNullException("selector");
        }
        return new AsyncSelectEnumerable<T, TResult>(this, selector);
    }

    public AsyncMapAsyncEnumerable<T, TResult> MapAsync<TResult>(
        delegate(T) => Task<TResult> selector) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (selector == null) {
            throw new System.ArgumentNullException("selector");
        }
        return new AsyncMapAsyncEnumerable<T, TResult>(this, selector);
    }

    public AsyncTakeEnumerable<T> Take(uint count) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncTakeEnumerable<T>(this, count);
    }

    public AsyncSkipEnumerable<T> Skip(uint count) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncSkipEnumerable<T>(this, count);
    }

    /// <summary>Returns a deferred, checked page of an asynchronous sequence.</summary>
    public AsyncTakeEnumerable<T> Page(
        uint pageIndex,
        uint pageSize) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (pageSize == 0u) {
            return this.Take(0u);
        }
        if (pageIndex > 4294967295u / pageSize) {
            throw new System.ArgumentOutOfRangeException("pageIndex");
        }
        uint offset = pageIndex * pageSize;
        return this.Skip(offset).Take(pageSize);
    }

    public AsyncFilterEnumerable<T> Filter(
        delegate(T) => bool predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new AsyncFilterEnumerable<T>(this, predicate);
    }

    /// <summary>Filters an asynchronous sequence with an awaited predicate.</summary>
    public AsyncFilterAsyncEnumerable<T> FilterAsync(
        delegate(T) => Task<bool> predicate) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new AsyncFilterAsyncEnumerable<T>(this, predicate);
    }

    /// <summary>Returns whether this asynchronous sequence has an element.</summary>
    public Task<bool> AnyAsync(
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncAnyOperation<T, uint>(
            this, null, cancellationToken, null, new Task<bool>()).Start();
    }

    /// <summary>Returns whether any asynchronous element satisfies the predicate.</summary>
    public Task<bool> AnyAsync(
        delegate(T) => bool predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new AsyncAnyOperation<T, uint>(
            this, predicate, cancellationToken, null, new Task<bool>()).Start();
    }

    /// <summary>Returns whether any asynchronous element matches an awaited predicate.</summary>
    public Task<bool> AnyAsync(
        delegate(T) => Task<bool> predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return this.FilterAsync(predicate).AnyAsync(cancellationToken);
    }


    /// <summary>Counts this asynchronous sequence with checked UInt32 arithmetic.</summary>
    public Task<uint> CountAsync(
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncCountOperation<T, uint>(
            this, null, cancellationToken, null, 0u,
            new Task<uint>()).Start();
    }

    /// <summary>Counts asynchronous elements satisfying the predicate.</summary>
    public Task<uint> CountAsync(
        delegate(T) => bool predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new AsyncCountOperation<T, uint>(
            this, predicate, cancellationToken, null, 0u,
            new Task<uint>()).Start();
    }

    /// <summary>Counts asynchronous elements matching an awaited predicate.</summary>
    public Task<uint> CountAsync(
        delegate(T) => Task<bool> predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return this.FilterAsync(predicate).CountAsync(cancellationToken);
    }


    /// <summary>Returns the first asynchronous element.</summary>
    public Task<T> FirstAsync(CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "First", 0u, false, null, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the first asynchronous element matching the predicate.</summary>
    public Task<T> FirstAsync(
        delegate(T) => bool predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "First", 0u, false, predicate, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the first asynchronous element matching an awaited predicate.</summary>
    public Task<T> FirstAsync(
        delegate(T) => Task<bool> predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return this.FilterAsync(predicate).FirstAsync(cancellationToken);
    }

    /// <summary>Returns the first asynchronous element or the default value.</summary>
    public Task<T> FirstOrDefaultAsync(
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "First", 0u, true, null, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the first matching asynchronous element or the default value.</summary>
    public Task<T> FirstOrDefaultAsync(
        delegate(T) => bool predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "First", 0u, true, predicate, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the first element matching an awaited predicate or default.</summary>
    public Task<T> FirstOrDefaultAsync(
        delegate(T) => Task<bool> predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return this.FilterAsync(predicate).FirstOrDefaultAsync(
            cancellationToken);
    }


    /// <summary>Returns the last asynchronous element.</summary>
    public Task<T> LastAsync(CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "Last", 0u, false, null, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the last asynchronous element matching the predicate.</summary>
    public Task<T> LastAsync(
        delegate(T) => bool predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "Last", 0u, false, predicate, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the last element matching an awaited predicate.</summary>
    public Task<T> LastAsync(
        delegate(T) => Task<bool> predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return this.FilterAsync(predicate).LastAsync(cancellationToken);
    }


    /// <summary>Returns the last asynchronous element or the default value.</summary>
    public Task<T> LastOrDefaultAsync(
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "Last", 0u, true, null, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the last matching asynchronous element or the default value.</summary>
    public Task<T> LastOrDefaultAsync(
        delegate(T) => bool predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "Last", 0u, true, predicate, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the last matching element or default using an awaited predicate.</summary>
    public Task<T> LastOrDefaultAsync(
        delegate(T) => Task<bool> predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return this.FilterAsync(predicate).LastOrDefaultAsync(
            cancellationToken);
    }


    /// <summary>Returns the only asynchronous element.</summary>
    public Task<T> SingleAsync(CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "Single", 0u, false, null, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the only asynchronous element matching the predicate.</summary>
    public Task<T> SingleAsync(
        delegate(T) => bool predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "Single", 0u, false, predicate, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the only element matching an awaited predicate.</summary>
    public Task<T> SingleAsync(
        delegate(T) => Task<bool> predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return this.FilterAsync(predicate).SingleAsync(cancellationToken);
    }


    /// <summary>Returns the only asynchronous element or the default value.</summary>
    public Task<T> SingleOrDefaultAsync(
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "Single", 0u, true, null, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the only matching asynchronous element or the default value.</summary>
    public Task<T> SingleOrDefaultAsync(
        delegate(T) => bool predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "Single", 0u, true, predicate, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the only matching element or default using an awaited predicate.</summary>
    public Task<T> SingleOrDefaultAsync(
        delegate(T) => Task<bool> predicate,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (predicate == null) {
            throw new System.ArgumentNullException("predicate");
        }
        return this.FilterAsync(predicate).SingleOrDefaultAsync(
            cancellationToken);
    }


    /// <summary>Returns the asynchronous element at the requested zero-based index.</summary>
    public Task<T> ElementAtAsync(
        uint index,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "ElementAt", index, false, null, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Returns the asynchronous element at the index or the default value.</summary>
    public Task<T> ElementAtOrDefaultAsync(
        uint index,
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncPositionOperation<T, uint>(
            this, "ElementAt", index, true, null, cancellationToken, null,
            false, new Task<T>()).Start();
    }

    /// <summary>Materializes this asynchronous sequence as a list.</summary>
    public Task<List<T>> ToListAsync(
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new AsyncListMaterializer<T, uint>(
            this,
            cancellationToken,
            null,
            new List<T>(),
            new Task<List<T>>()).Start();
    }

    /// <summary>Materializes this asynchronous sequence as an array.</summary>
    public Task<T[]> ToArrayAsync(
        CancellationToken cancellationToken) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        Task<List<T>> listTask = ToListAsync(cancellationToken);
        return new AsyncArrayMaterializer<T, uint>(
            listTask, new Task<T[]>()).Start();
    }
}
