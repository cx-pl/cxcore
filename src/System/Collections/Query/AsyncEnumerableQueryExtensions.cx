/// <summary>Continuation-driven enumerator for an awaited filter predicate.</summary>
public final class AsyncFilterAsyncEnumerator<T> : IAsyncEnumerator<T> {
    private IAsyncEnumerable<T> _source;
    private IAsyncEnumerator<T> _sourceEnumerator;
    private delegate(T) => Task<bool> _predicate;
    private CancellationToken _cancellationToken;
    private TaskHandle _disposeTask;
    private TaskCompletionSource _disposeCompletion;
    private Task<bool> _moveCompletion;
    private T _candidate;
    private T _current;
    private bool _sourceOpened;
    private bool _disposed;
    private bool _disposeStarted;
    private bool _movePending;

    public T Current { const get => _current; }

    internal constructor(
        IAsyncEnumerable<T> source,
        delegate(T) => Task<bool> predicate,
        CancellationToken cancellationToken) {
        _source = source;
        _sourceEnumerator = null;
        _predicate = predicate;
        _cancellationToken = cancellationToken;
        _disposeTask = null;
        _disposeCompletion = null;
        _moveCompletion = null;
        _sourceOpened = false;
        _disposed = false;
        _disposeStarted = false;
        _movePending = false;
    }

    public ValueTask<bool> MoveNextAsync() {
        if (_disposed) {
            return new ValueTask<bool>(false);
        }
        if (_movePending) {
            throw new System.InvalidOperationException(
                "A filter MoveNextAsync operation is already pending.");
        }
        _current = default;
        _candidate = default;
        Task<bool> completion = new Task<bool>();
        _moveCompletion = completion;
        _movePending = true;
        try {
            if (!_sourceOpened) {
                IAsyncEnumerator<T> sourceEnumerator =
                    _source.GetAsyncEnumerator(
                    _cancellationToken);
                if (sourceEnumerator == null) {
                    throw new System.InvalidOperationException(
                        "The async source returned no enumerator.");
                }
                _sourceEnumerator = sourceEnumerator;
                _sourceOpened = true;
            }
            Advance();
        } catch (System.Exception exception) {
            CompleteMoveException(exception);
        }
        ValueTask<bool> result;
        result.SetTask(completion);
        return result;
    }

    private void Advance() {
        while (_movePending && !_disposed) {
            try {
                ValueTask<bool> moveValueTask =
                    _sourceEnumerator.MoveNextAsync();
                Task<bool> moveTask = moveValueTask.AsTask();
                if (!moveTask.IsCompleted) {
                    AsyncFilterAsyncEnumerator<T> state = this;
                    moveTask.OnCompleted(() =>
                        state.CompleteSourceMove(moveTask));
                    return;
                }
                if (!moveTask.GetResult()) {
                    CompleteMoveResult(false);
                    return;
                }
                _candidate = _sourceEnumerator.Current;
                Task<bool> predicateTask = _predicate(_candidate);
                if (predicateTask == null) {
                    throw new System.InvalidOperationException(
                        "The async predicate returned no task.");
                }
                if (!predicateTask.IsCompleted) {
                    AsyncFilterAsyncEnumerator<T> state = this;
                    predicateTask.OnCompleted(() =>
                        state.CompletePredicate(predicateTask));
                    return;
                }
                if (predicateTask.GetResult()) {
                    _current = _candidate;
                    CompleteMoveResult(true);
                    return;
                }
                _candidate = default;
            } catch (System.Exception exception) {
                CompleteMoveException(exception);
                return;
            }
        }
    }

    private void CompleteSourceMove(Task<bool> moveTask) {
        if (!_movePending) {
            return;
        }
        try {
            bool moved = moveTask.GetResult();
            if (!moved || _disposed) {
                CompleteMoveResult(false);
                return;
            }
            _candidate = _sourceEnumerator.Current;
            Task<bool> predicateTask = _predicate(_candidate);
            if (predicateTask == null) {
                throw new System.InvalidOperationException(
                    "The async predicate returned no task.");
            }
            if (!predicateTask.IsCompleted) {
                AsyncFilterAsyncEnumerator<T> state = this;
                predicateTask.OnCompleted(() =>
                    state.CompletePredicate(predicateTask));
                return;
            }
            if (predicateTask.GetResult()) {
                _current = _candidate;
                CompleteMoveResult(true);
            } else {
                _candidate = default;
                Advance();
            }
        } catch (System.Exception exception) {
            CompleteMoveException(exception);
        }
    }

    private void CompletePredicate(Task<bool> predicateTask) {
        if (!_movePending) {
            return;
        }
        try {
            bool accepted = predicateTask.GetResult();
            if (_disposed) {
                CompleteMoveResult(false);
            } else if (accepted) {
                _current = _candidate;
                CompleteMoveResult(true);
            } else {
                _candidate = default;
                Advance();
            }
        } catch (System.Exception exception) {
            CompleteMoveException(exception);
        }
    }

    private void CompleteMoveResult(bool moved) {
        if (!_movePending) {
            return;
        }
        Task<bool> completion = _moveCompletion;
        _moveCompletion = null;
        _movePending = false;
        _candidate = default;
        completion.SetResult(moved);
    }

    private void CompleteMoveException(System.Exception exception) {
        if (!_movePending) {
            return;
        }
        Task<bool> completion = _moveCompletion;
        _moveCompletion = null;
        _movePending = false;
        _candidate = default;
        if (exception is OperationCanceledException) {
            completion.SetCanceled();
        } else {
            completion.SetFault(exception);
        }
    }

    private void DisposeAfterPendingMove(Task<bool> pendingMove) {
        try {
            pendingMove.GetResult();
        } catch (System.Exception) {
            // The move caller observes its failure; disposal still waits for it.
        }
        _source = default;
        _predicate = default;
        _current = default;
        _candidate = default;
        _cancellationToken = default;
        TaskHandle upstreamDispose;
        try {
            upstreamDispose = _sourceEnumerator.DisposeAsync().AsTask();
            _sourceEnumerator = default;
        } catch (System.Exception exception) {
            _sourceEnumerator = default;
            _disposeCompletion.SetException(exception);
            return;
        }
        if (upstreamDispose.IsCompleted) {
            CompletePendingDispose(upstreamDispose);
        } else {
            AsyncFilterAsyncEnumerator<T> state = this;
            upstreamDispose.OnCompleted(() =>
                state.CompletePendingDispose(upstreamDispose));
        }
    }

    private void CompletePendingDispose(TaskHandle upstreamDispose) {
        try {
            upstreamDispose.GetResult();
            _disposeCompletion.SetResult();
        } catch (OperationCanceledException) {
            _disposeCompletion.SetCanceled();
        } catch (System.Exception exception) {
            _disposeCompletion.SetException(exception);
        }
    }

    public ValueTask DisposeAsync() {
        if (_disposeStarted) {
            return new ValueTask(_disposeTask);
        }
        _disposeStarted = true;
        _disposed = true;
        if (_movePending) {
            _disposeCompletion = new TaskCompletionSource();
            _disposeTask = _disposeCompletion.Task;
            Task<bool> pendingMove = _moveCompletion;
            AsyncFilterAsyncEnumerator<T> state = this;
            pendingMove.OnCompleted(() =>
                state.DisposeAfterPendingMove(pendingMove));
            return new ValueTask(_disposeTask);
        }
        _source = default;
        _predicate = default;
        _current = default;
        _candidate = default;
        _cancellationToken = default;
        if (_sourceOpened) {
            ValueTask disposeValueTask = _sourceEnumerator.DisposeAsync();
            _sourceEnumerator = default;
            _disposeTask = disposeValueTask.AsTask();
        } else {
            _disposeTask = new TaskHandle();
        }
        return new ValueTask(_disposeTask);
    }
}

/// <summary>A replayable asynchronous Skip query.</summary>
public final class AsyncSkipEnumerable<T> : IAsyncEnumerable<T> {
    private IAsyncEnumerable<T> _source;
    private uint _count;

    internal constructor(IAsyncEnumerable<T> source, uint count) {
        _source = source;
        _count = count;
    }

    public IAsyncEnumerator<T> GetAsyncEnumerator(
        CancellationToken cancellationToken) {
        return new AsyncSkipEnumerator<T>(
            _source, _count, cancellationToken);
    }
}

public final class AsyncSkipEnumerator<T> : IAsyncEnumerator<T> {
    private IAsyncEnumerable<T> _source;
    private IAsyncEnumerator<T> _sourceEnumerator;
    private CancellationToken _cancellationToken;
    private TaskHandle _disposeTask;
    private TaskCompletionSource _disposeCompletion;
    private Task<bool> _pendingMove;
    private T _current;
    private uint _remaining;
    private bool _sourceOpened;
    private bool _disposed;
    private bool _disposeStarted;

    public T Current { const get => _current; }

    internal constructor(
        IAsyncEnumerable<T> source,
        uint count,
        CancellationToken cancellationToken) {
        _source = source;
        _sourceEnumerator = null;
        _cancellationToken = cancellationToken;
        _disposeTask = null;
        _disposeCompletion = null;
        _pendingMove = null;
        _remaining = count;
        _sourceOpened = false;
        _disposed = false;
        _disposeStarted = false;
    }

    public ValueTask<bool> MoveNextAsync() {
        if (_disposed) {
            return new ValueTask<bool>(false);
        }
        if (_pendingMove != null && !_pendingMove.IsCompleted) {
            throw new System.InvalidOperationException(
                "A Skip MoveNextAsync operation is already pending.");
        }
        _current = default;
        if (!_sourceOpened) {
            _sourceOpened = true;
            _sourceEnumerator = _source.GetAsyncEnumerator(
                _cancellationToken);
            if (_sourceEnumerator == null) {
                _sourceOpened = false;
                throw new System.InvalidOperationException(
                    "The async source returned a null enumerator.");
            }
        }
        Task<bool> moving = MoveNextCoreAsync(
            this, _sourceEnumerator);
        _pendingMove = moving;
        ValueTask<bool> result;
        result.SetTask(moving);
        return result;
    }

    private async Task<bool> MoveNextCoreAsync(
        AsyncSkipEnumerator<T> state,
        IAsyncEnumerator<T> sourceEnumerator) {
        while (true) {
            bool moved = await sourceEnumerator.MoveNextAsync();
            if (!moved || state._disposed) {
                return false;
            }
            if (state._remaining != 0u) {
                state._remaining -= 1u;
                continue;
            }
            state._current = sourceEnumerator.Current;
            return true;
        }
        return false;
    }

    private void DisposeAfterPendingMove() {
        try {
            _pendingMove.GetResult();
        } catch (System.Exception) {
            // The move operation reports its own failure to its caller.
        }
        _pendingMove = default;
        TaskHandle upstreamDispose;
        try {
            upstreamDispose = _sourceEnumerator.DisposeAsync().AsTask();
            _sourceEnumerator = default;
        } catch (System.Exception exception) {
            _sourceEnumerator = default;
            _disposeCompletion.SetException(exception);
            return;
        }
        if (upstreamDispose.IsCompleted) {
            CompletePendingDispose(upstreamDispose);
        } else {
            AsyncSkipEnumerator<T> state = this;
            upstreamDispose.OnCompleted(() =>
                state.CompletePendingDispose(upstreamDispose));
        }
    }

    private void CompletePendingDispose(TaskHandle upstreamDispose) {
        try {
            upstreamDispose.GetResult();
            _disposeCompletion.SetResult();
        } catch (OperationCanceledException) {
            _disposeCompletion.SetCanceled();
        } catch (System.Exception exception) {
            _disposeCompletion.SetException(exception);
        }
    }

    public ValueTask DisposeAsync() {
        if (_disposeStarted) {
            return new ValueTask(_disposeTask);
        }
        _disposeStarted = true;
        _disposed = true;
        _source = default;
        _current = default;
        if (_pendingMove != null && !_pendingMove.IsCompleted) {
            _disposeCompletion = new TaskCompletionSource();
            _disposeTask = _disposeCompletion.Task;
            AsyncSkipEnumerator<T> state = this;
            _pendingMove.OnCompleted(() => state.DisposeAfterPendingMove());
            return new ValueTask(_disposeTask);
        }
        if (_sourceOpened) {
            ValueTask disposeValueTask = _sourceEnumerator.DisposeAsync();
            _sourceEnumerator = default;
            _disposeTask = disposeValueTask.AsTask();
        } else {
            _disposeTask = new TaskHandle();
        }
        return new ValueTask(_disposeTask);
    }
}

public final class AsyncTakeEnumerator<T> : IAsyncEnumerator<T> {
    private IAsyncEnumerable<T> _source;
    private IAsyncEnumerator<T> _sourceEnumerator;
    private CancellationToken _cancellationToken;
    private TaskHandle _disposeTask;
    private TaskCompletionSource _disposeCompletion;
    private Task<bool> _pendingMove;
    private uint _count;
    private uint _yielded;
    private bool _sourceOpened;
    private bool _disposed;
    private bool _disposeStarted;

    public T Current { const get { return _sourceEnumerator.Current; } }

    internal constructor(
        IAsyncEnumerable<T> source,
        uint count,
        CancellationToken cancellationToken) {
        _source = source;
        _sourceEnumerator = null;
        _cancellationToken = cancellationToken;
        _disposeTask = null;
        _disposeCompletion = null;
        _pendingMove = null;
        _count = count;
        _yielded = 0u;
        _sourceOpened = false;
        _disposed = false;
        _disposeStarted = false;
    }

    public ValueTask<bool> MoveNextAsync() {
        if (_disposed) {
            return new ValueTask<bool>(false);
        }
        if (_pendingMove != null && !_pendingMove.IsCompleted) {
            throw new System.InvalidOperationException(
                "A Take MoveNextAsync operation is already pending.");
        }
        if (_count == 0u || _yielded >= _count) {
            _disposed = true;
            return new ValueTask<bool>(false);
        }
        if (!_sourceOpened) {
            _sourceOpened = true;
            _sourceEnumerator = _source.GetAsyncEnumerator(
                _cancellationToken);
            if (_sourceEnumerator == null) {
                _sourceOpened = false;
                throw new System.InvalidOperationException(
                    "The async source returned a null enumerator.");
            }
        }
        Task<bool> sourceMove = _sourceEnumerator.MoveNextAsync().AsTask();
        if (sourceMove.IsCompleted) {
            try {
                bool moved = sourceMove.GetResult();
                if (moved && !_disposed) {
                    _yielded += 1u;
                    return new ValueTask<bool>(true);
                }
                return new ValueTask<bool>(false);
            } catch (OperationCanceledException) {
                Task<bool> canceled = new Task<bool>();
                canceled.SetCanceled();
                ValueTask<bool> canceledValueTask;
                canceledValueTask.SetTask(canceled);
                return canceledValueTask;
            } catch (System.Exception exception) {
                Task<bool> faulted = new Task<bool>();
                faulted.SetFault(exception);
                ValueTask<bool> faultedValueTask;
                faultedValueTask.SetTask(faulted);
                return faultedValueTask;
            }
        }
        TaskCompletionSource<bool> completion =
            new TaskCompletionSource<bool>();
        _pendingMove = completion.GetTask();
        AsyncTakeEnumerator<T> state = this;
        sourceMove.OnCompleted(() =>
            state.CompleteMove(sourceMove, completion));
        ValueTask<bool> result;
        result.SetTask(_pendingMove);
        return result;
    }

    private void CompleteMove(
        Task<bool> sourceMove,
        TaskCompletionSource<bool> completion) {
        try {
            bool moved = sourceMove.GetResult();
            if (moved && !_disposed) {
                _yielded += 1u;
                completion.SetResult(true);
            } else {
                completion.SetResult(false);
            }
        } catch (OperationCanceledException) {
            completion.SetCanceled();
        } catch (System.Exception exception) {
            completion.SetException(exception);
        }
    }

    private void DisposeAfterPendingMove() {
        try {
            _pendingMove.GetResult();
        } catch (System.Exception) {
            // The move operation reports its own failure to its caller.
        }
        _pendingMove = default;
        TaskHandle upstreamDispose;
        try {
            upstreamDispose = _sourceEnumerator.DisposeAsync().AsTask();
            _sourceEnumerator = default;
        } catch (System.Exception exception) {
            _sourceEnumerator = default;
            _disposeCompletion.SetException(exception);
            return;
        }
        if (upstreamDispose.IsCompleted) {
            CompletePendingDispose(upstreamDispose);
        } else {
            AsyncTakeEnumerator<T> state = this;
            upstreamDispose.OnCompleted(() =>
                state.CompletePendingDispose(upstreamDispose));
        }
    }

    private void CompletePendingDispose(TaskHandle upstreamDispose) {
        try {
            upstreamDispose.GetResult();
            _disposeCompletion.SetResult();
        } catch (OperationCanceledException) {
            _disposeCompletion.SetCanceled();
        } catch (System.Exception exception) {
            _disposeCompletion.SetException(exception);
        }
    }

    public ValueTask DisposeAsync() {
        if (_disposeStarted) {
            return new ValueTask(_disposeTask);
        }
        _disposeStarted = true;
        _disposed = true;
        _source = default;
        if (_pendingMove != null && !_pendingMove.IsCompleted) {
            _disposeCompletion = new TaskCompletionSource();
            _disposeTask = _disposeCompletion.Task;
            AsyncTakeEnumerator<T> state = this;
            _pendingMove.OnCompleted(() => state.DisposeAfterPendingMove());
            return new ValueTask(_disposeTask);
        }
        if (_sourceOpened) {
            ValueTask disposeValueTask = _sourceEnumerator.DisposeAsync();
            _sourceEnumerator = default;
            _disposeTask = disposeValueTask.AsTask();
        } else {
            _disposeTask = new TaskHandle();
        }
        return new ValueTask(_disposeTask);
    }
}
