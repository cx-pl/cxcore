import System.Collections;

namespace System.Collections.Query;
public extension ArrayWhereMapExtensions<T> : ArrayWhereEnumerable<T> {
    public ArrayWhereMapEnumerable<T, TResult> Map<TResult>(
        delegate(T) => TResult selector) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        if (selector == null) {
            throw new System.ArgumentNullException("selector");
        }
        return new ArrayWhereMapEnumerable<T, TResult>(this, selector);
    }
}
