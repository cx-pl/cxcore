import System.Collections;
import System.Threading.Tasks;

namespace System.Collections.Query;
/// <summary>
/// A typed captured-value cell. Providers snapshot Value once at the start of
/// each execution and bind that snapshot as a parameter.
/// </summary>
public final class QueryCapture<T> {
    public T Value;

    public constructor(T value) {
        Value = value;
    }

    /// <summary>Creates a typed expression that refers to this live capture cell.</summary>
    public QueryExpression<T> AsExpression(string name) const {
        if (name == null) {
            throw new System.ArgumentNullException("name");
        }
        return new QueryExpression<T>(
            "CapturedValue", name, this, null, null);
    }
}
