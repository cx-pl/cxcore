import System.Collections;

namespace System.Collections.Query;
public final class ArrayWhereSkipEnumerable<T> : IEnumerable<T> {
    internal ArrayWhereEnumerable<T> _source;
    internal uint _skip;

    internal constructor(ArrayWhereEnumerable<T> source, uint skip) {
        _source = source;
        _skip = skip;
    }

    public IEnumerator<T> GetEnumerator() const {
        return new IndexedWhereTakeEnumerator<T>(
            _source._source, _source._predicate,
            _source._source.Length, _skip, 4294967295u);
    }

    public ArrayWhereSkipTakeEnumerable<T> Take(uint count) const {
        if (this == null) {
            throw new System.ArgumentNullException("source");
        }
        return new ArrayWhereSkipTakeEnumerable<T>(this, count);
    }
}
