import System.Collections;

namespace System.Collections.Query;
public final class WhereMapTakeEnumerator<T, TResult> : IEnumerator<TResult> {
    private IEnumerable<T> _source;
    private IEnumerator<T> _enumerator;
    private delegate(T) => bool _predicate;
    private delegate(T) => TResult _selector;
    private uint _remaining;
    private TResult _current;
    private bool _started;
    private bool _disposed;

    public TResult Current { const get { return _current; } }

    internal constructor(
        IEnumerable<T> source,
        delegate(T) => bool predicate,
        delegate(T) => TResult selector,
        uint count) {
        _source = source;
        _predicate = predicate;
        _selector = selector;
        _remaining = count;
        _started = false;
        _disposed = false;
    }

    public bool MoveNext() {
        if (_disposed) {
            Dispose();
            return false;
        }
        if (_remaining == 0u) {
            Dispose();
            return false;
        }
        try {
            if (!_started) {
                _enumerator = _source.GetEnumerator();
                _started = true;
            }
            while (_enumerator.MoveNext()) {
                T value = _enumerator.Current;
                if (!_predicate(value)) {
                    continue;
                }
                _current = _selector(value);
                _remaining -= 1u;
                if (_remaining == 0u) {
                    ReleaseSource();
                }
                return true;
            }
        } catch (System.Exception) {
            Dispose();
            throw;
        }
        Dispose();
        return false;
    }

    private void ReleaseSource() {
        if (!_disposed) {
            _disposed = true;
            if (_started) {
                _enumerator.Dispose();
            }
        }
        _source = default;
        _enumerator = default;
        _predicate = default;
        _selector = default;
    }

    public void Dispose() {
        ReleaseSource();
        _current = default;
    }
}
