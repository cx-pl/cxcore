namespace System;

public struct Char {
    private char _value;

    public bool IsDigit {
        const get {
            return IsBetween(_value, '0', '9');
        }
    }

    public bool IsLower {
        const get {
            return IsBetween(_value, 'a', 'z');
        }
    }

    public bool IsUpper{
        const get {
            return IsBetween(_value, 'A', 'Z');
        }
    }

    public bool IsLetter {
        const get {
            return IsLower || IsUpper;
        }
    }

    public bool IsWhiteSpace {
        const get {
            return 
                _value == ' ' ||
                _value == '\t' ||
                _value == '\r' ||
                _value == '\n';
        }
    }

    public int NumBytes {
        extern const get;
    }

    public static bool IsBetween(char c, char min, char max) {
        return c >= min && c <= max;
    }

    public char ToLower() const {
        return this.IsUpper
            ? _value + 'a' - 'A'
            : _value;
    }

    public char ToUpper() const {
        return this.IsLower
            ? _value + 'A' - 'a'
            : _value;
    }
}
